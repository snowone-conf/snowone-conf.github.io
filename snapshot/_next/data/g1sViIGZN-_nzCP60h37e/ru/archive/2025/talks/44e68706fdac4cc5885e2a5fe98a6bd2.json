u":"https://smartdataconf.ru/","en":"https://smartdataconf.ru/en/"},"logo":{"id":"e6f0783d-b91c-46c6-be2b-2f113f63c229","title":"smartdata.svg","url":"/squidex/srm/e6f0783d-b91c-46c6-be2b-2f113f63c229/smartdata.svg","fileName":"smartdata.svg","contentType":"image/svg+xml","details":{}},"color":"#44d8b1","stack":{"ru":"Data Engineering","en":"Data Engineering"}},{"project":"tt","title":{"ru":"TechTrain","en":"TechTrain"},"url":{"ru":"https://techtrain.ru/","en":"https://techtrain.ru/"},"logo":{"id":"8349dfdd-d9ed-4be9-9771-007d399c40e9","title":"techtrain.svg","url":"/squidex/srm/8349dfdd-d9ed-4be9-9771-007d399c40e9/techtrain.svg","fileName":"techtrain.svg","contentType":"image/svg+xml","details":{}},"color":"#ff5e29"},{"project":"videotech","title":{"ru":"VideoTech","en":"VideoTech"},"url":{"ru":"https://vtconf.com/","en":"https://vtconf.com/en/"},"logo":{"id":"b28d58c7-2204-4177-b7b9-dd244015638c","title":"videotech.svg","url":"/squidex/srm/b28d58c7-2204-4177-b7b9-dd244015638c/videotech.svg","fileName":"videotech.svg","contentType":"image/svg+xml","details":{}},"color":"#20bdff","stack":{"ru":"Video & Streaming","en":"Video & Streaming"}},{"project":"sysconf","title":{"ru":"sysconf","en":"sysconf"},"url":{"ru":"https://sysconf.pro/","en":"https://sysconf.pro/"},"logo":{"id":"cecf9277-b0dd-4adb-8b66-d748d13ed382","title":"sysconf.svg","url":"/squidex/srm/cecf9277-b0dd-4adb-8b66-d748d13ed382/sysconf.svg","fileName":"sysconf.svg","contentType":"image/svg+xml","details":{}},"color":"#4c5aff","stack":{"ru":"Системное программирование","en":"System programming"}}],"meta":{"title":"Уроки Kotlin, или Зачем создавать еще один язык программирования | Доклад на SnowOne 2025","description":"В мире есть множество языков программирования. Казалось бы, для каждой задачи уже какой-то язык есть &mdash; просто бери и используй. Так зачем же делать еще один? Зачем мы создавали язык Kotlin? Чего нам не хватало в Java? Является ли Kotlin теперь идеальным языком? Чего не хватает в Kotlin?&nbsp;"},"localeConfig":{"locales":["ru"],"defaultLocale":"ru"},"locale":"ru","talk":{"id":"44e68706fdac4cc5885e2a5fe98a6bd2","name":{"ru":"Уроки Kotlin, или Зачем создавать еще один язык программирования","en":"-"},"talkOrder":50,"shortDescription":{"ru":"<p>В мире есть множество языков программирования. Казалось бы, для каждой задачи уже какой-то язык есть &mdash; просто бери и используй. Так зачем же делать еще один? Зачем мы создавали язык Kotlin? Чего нам не хватало в Java? Является ли Kotlin теперь идеальным языком? Чего не хватает в Kotlin?&nbsp;</p>","en":"<p>-</p>"},"longDescription":{"ru":"<p>В мире есть множество языков программирования. Казалось бы, для каждой задачи уже какой-то язык есть &mdash; просто бери и используй. Так зачем же делать еще один? Зачем мы создавали язык Kotlin? Чего нам не хватало в Java? Является ли Kotlin теперь идеальным языком? Чего не хватает в Kotlin?</p>\n<p>Приходите, если вам интересны ответы на эти вопросы или вы просто интересуетесь языками программирования. Я расскажу об основных аспектах старых и современных языков, на которые стоит обращать внимание, и объясню, почему дизайн языка программирования &mdash; это всегда компромиcс.</p>","en":"<p>-</p>"},"isRussianLanguage":true,"speakers":[{"id":"bc354f2a7d8c44dfa16f9c1644631a42","name":{"ru":"Роман Елизаров","en":"- -"},"personRating":100,"company":{"ru":"Яндекс","en":"-"},"bio":{"ru":"<p>Эксперт по многопоточности и распределенному программированию, преподаю тематический курс в ИТМО в Санкт-Петербурге.</p>\n<p>15 лет разрабатывал высоконагруженные системы для бирж и брокеров в Devexperts, преимущественно используя Java. В недавнем прошлом 7 лет работал в JetBrains, где возглавлял команду, работающую над языком Kotlin, фокусируясь на дизайне языка и библиотек. Автор корутин в Kotlin &mdash; механизма для асинхронных вычислений.</p>\n<p>Сейчас руковожу отделом улучшения опыта разработки в бизнес-группе Екома и Райдтеха Яндекса, где отвечаю за удобство работы и счастье разработчиков.</p>","en":"<p>-</p>"},"speaker":false,"committee":false,"photo":{"id":"8929fb89-372a-4ad5-8746-ebf90a2d28c8","title":"Roman.Elizarov.jpg","url":"/squidex/srm/8929fb89-372a-4ad5-8746-ebf90a2d28c8/roman.elizarov.jpg","fileName":"Roman.Elizarov.jpg","contentType":"image/jpeg","details":{"image":{"width":644,"height":644}}},"contacts":[],"achievements":null,"isPartner":false,"contributorId":22000140}],"ogImage":{"ru":{"id":"2baee343-4525-4ab3-844f-d42e101607da","title":"Уроки Kotlin, или Зачем создавать еще один язык пр_Og_speaker_ru.jpg","url":"/squidex/srm/2baee343-4525-4ab3-844f-d42e101607da/uroki-kotlin-ili-zachem-sozdavats-eshe-odin-yazyk-pr-og-speaker-ru.jpg","fileName":"Уроки Kotlin, или Зачем создавать еще один язык пр_Og_speaker_ru.jpg","contentType":"image/jpeg","details":{"image":{"width":1920,"height":862}}},"en":{"id":"2baee343-4525-4ab3-844f-d42e101607da","title":"Уроки Kotlin, или Зачем создавать еще один язык пр_Og_speaker_ru.jpg","url":"/squidex/srm/2baee343-4525-4ab3-844f-d42e101607da/uroki-kotlin-ili-zachem-sozdavats-eshe-odin-yazyk-pr-og-speaker-ru.jpg","fileName":"Уроки Kotlin, или Зачем создавать еще один язык пр_Og_speaker_ru.jpg","contentType":"image/jpeg","details":{"image":{"width":1920,"height":862}}}},"talkDay":1,"time":"2025-02-28T12:30:00Z","talkStartTime":"2025-02-28T12:30:00Z","talkEndTime":"2025-02-28T13:15:00Z","trackNumber":1,"tags":[],"videoLinks":[],"complexity":null,"talkId":20006900,"experts":[],"hosts":[],"technicalTags":[],"type":"talk","scope":"regular","topics":[["Студенческий день",1]],"isServiceTalk":false,"partners":[]},"relatedTalks":[["Студенческий день",1,3,[{"id":"95b086e947864a338e46cc4162d6bc62","name":{"ru":"Мысли в контексте!","en":"-"},"talkOrder":50,"shortDescription":{"ru":"<p>Расскажу, что такое контекстно-ориентированное программирование, как оно работает (да!) в разных языках. Разумеется, обсудим контекстные ресиверы и контекстные параметры в Kotlin (параметры выходят в 2.2) и зачем они нужны.</p>","en":"<p>-</p>"},"longDescription":{"ru":"<p>Расскажу, что такое контекстно-ориентированное программирование, как оно работает (да!) в разных языках. Разумеется, обсудим контекстные ресиверы и контекстные параметры в Kotlin (параметры выходят в 2.2) и зачем они нужны.</p>","en":"<p>-</p>"},"isRussianLanguage":true,"speakers":[{"id":"5ba7be870c264d3586b3f10a0f5b605a","name":{"ru":"Александр Нозик","en":"- -"},"personRating":50,"company":{"ru":"МФТИ","en":"-"},"bio":{"ru":"<p>В школе у меня было три увлечения: настольные ролевые игры, физика и программирование. Когда пришло время выбирать профессию, я выбрал физику, думая, что она интереснее. И не ошибся. Но в результате занимаюсь программированием в физике.</p>\n<p>Преподаю физику, математическую статистику и Kotlin в МФТИ, директор центра научного программирования МФТИ, ex-руководитель направления в JetBrains Research. Имею кандидатскую степень по физике частиц.</p>\n<p>С 2006 года в разработке, в том числе коммерческой. В основном на Java, но с 2017 года в основном на Kotlin. Кроме этого были Python, Groovy, Julia и так далее.</p>\n<p>Стал GDE по Kotlin в 2021-м. Руководитель российской KUG (Kotlin User Group).</p>","en":"<p>-</p>"},"speaker":false,"committee":false,"photo":{"id":"1e052169-a8aa-492b-b889-1943854f78bf","title":"102366_1862017862_Aleksandr_Nozik_Arkhitektura_matematicheskikh_vychisleniy_na_Kotlin. (1).jpg","url":"/squidex/srm/1e052169-a8aa-492b-b889-1943854f78bf/102366-1862017862-aleksandr-nozik-arkhitektura-matematicheskikh-vychisleniy-na-kotlin.-1-.jpg","fileName":"102366_1862017862_Aleksandr_Nozik_Arkhitektura_matematicheskikh_vychisleniy_na_Kotlin. (1).jpg","contentType":"image/png","details":{"image":{"width":1611,"height":1611}}},"contacts":[{"type":"github","value":"https://github.com/altavir"}],"achievements":null,"isPartner":false,"contributorId":22002953}],"ogImage":{"ru":{"id":"2670634b-23e8-4083-a03a-ce237ec37dd3","title":"Мысли в контексте!_Og_speaker_ru.jpg","url":"/squidex/srm/2670634b-23e8-4083-a03a-ce237ec37dd3/mysli-v-kontekste-og-speaker-ru.jpg","fileName":"Мысли в контексте!_Og_speaker_ru.jpg","contentType":"image/jpeg","details":{"image":{"width":1920,"height":862}}},"en":{"id":"2670634b-23e8-4083-a03a-ce237ec37dd3","title":"Мысли в контексте!_Og_speaker_ru.jpg","url":"/squidex/srm/2670634b-23e8-4083-a03a-ce237ec37dd3/mysli-v-kontekste-og-speaker-ru.jpg","fileName":"Мысли в контексте!_Og_speaker_ru.jpg","contentType":"image/jpeg","details":{"image":{"width":1920,"height":862}}}},"talkDay":1,"time":"2025-02-28T09:15:00Z","talkStartTime":"2025-02-28T09:15:00Z","talkEndTime":"2025-02-28T10:00:00Z","trackNumber":1,"tags":[],"videoLinks":[],"complexity":null,"talkId":20006603,"experts":[],"hosts":[],"technicalTags":[],"type":"talk","scope":"regular","topics":[["Студенческий день",1]],"isServiceTalk":false,"partners":[]},{"id":"5cba1c5ed10842d09bbfa23af304f387","name":{"ru":"Разберемся с СI/CD: что это такое и зачем нужно разработчику","en":"-"},"talkOrder":50,"shortDescription":{"ru":"<p>Разберемся, что такое CI/CD, для чего нужно и зачем об этом знать разработчику. Рассмотрим основные этапы и пример реализации.</p>","en":"<p>-</p>"},"longDescription":{"ru":"<p>Скорость поставки и качество продукта &mdash; главные конкурентные преимущества в разработке ПО. Поэтому важно использовать лучшие практики сообщества для обеспечения этих двух пунктов. Одной из таких практик является CI/CD &mdash; Continuous Integration и Continuous Delivery &mdash; непрерывная интеграция и непрерывная доставка. Она помогает свести ошибки к минимуму, повысить качество разрабатываемого продукта и увеличить скорость его поставки клиенту. Без непрерывной интеграции сотрудничество разработчиков превращается в утомительный ручной процесс координации обновлений и слияний кода.</p>\n<p>Но, как и любой процесс, он может дорабатываться, ломаться и так далее. Поэтому, чтобы обеспечить бесперебойное время и качество поставки, важно понимать, из чего он состоит, какие подводные камни могут быть на каждом из этапов.</p>\n<p>В докладе как раз разберем на примере, чем это полезно не только с точки зрения конкурентных преимуществ для бизнеса, но и для самих разработчиков. Посмотрим, в чем преимущества и недостатки этой методологии. И разберем пример реализации с помощью инструмента Jenkins.</p>","en":"<p>-</p>"},"isRussianLanguage":true,"speakers":[{"id":"ea0bb75595794d4580a6301dc400dcc0","name":{"ru":"Екатерина Шевчук","en":"Екатерина Шевчук"},"personRating":50,"company":{"ru":"Koronatech","en":"ЦФТ"},"bio":{"ru":"<p>Старший инженер-разработчик. Тимлид инфраструктурной команды. Куратор курсов ШИФТ Интенсив в Koronatech, направление &laquo;Java-разработка&raquo;. Участник Программного комитета направления Backend в Koronatech (для внутренних и внешних конференций). Выступала на внешних митапах от своей компании и на SnowOne в 2024 году.</p>","en":"<p>Старший инженер-разработчик. Тимлид инфраструктурной команды. Куратор курсов ШИФТ Интенсив в Koronatech, направление &laquo;Java-разработка&raquo;. Участник Программного комитета направления Backend в Koronatech (для внутренних и внешних конференций). Выступала на внешних митапах от своей компании и на SnowOne в 2024 году.</p>"},"speaker":false,"committee":false,"photo":{"id":"d25e65b6-c12f-4487-99ce-b23d8f8bd0ea","title":"шевчук.jpg","url":"/squidex/srm/d25e65b6-c12f-4487-99ce-b23d8f8bd0ea/shevchuk.jpg","fileName":"шевчук.jpg","contentType":"image/png","details":{"image":{"width":2436,"height":2192}}},"contacts":[],"achievements":null,"isPartner":false,"position":{"ru":"Старший инженер-программист","en":"Старший инженер-программист"},"contributorId":22005413}],"ogImage":{"ru":{"id":"772aa524-59bc-4d0f-aaea-1dcf4d6de5d3","title":"CD_ что это такое и зачем нужно ра_Og_speaker_ru.jpg","url":"/squidex/srm/772aa524-59bc-4d0f-aaea-1dcf4d6de5d3/cd-chto-eto-takoe-i-zachem-nuzhno-ra-og-speaker-ru.jpg","fileName":"CD_ что это такое и зачем нужно ра_Og_speaker_ru.jpg","contentType":"image/jpeg","details":{"image":{"width":1920,"height":862}}},"en":{"id":"772aa524-59bc-4d0f-aaea-1dcf4d6de5d3","title":"CD_ что это такое и зачем нужно ра_Og_speaker_ru.jpg","url":"/squidex/srm/772aa524-59bc-4d0f-aaea-1dcf4d6de5d3/cd-chto-eto-takoe-i-zachem-nuzhno-ra-og-speaker-ru.jpg","fileName":"CD_ что это такое и зачем нужно ра_Og_speaker_ru.jpg","contentType":"image/jpeg","details":{"image":{"width":1920,"height":862}}}},"talkDay":1,"time":"2025-02-28T11:30:00Z","talkStartTime":"2025-02-28T11:30:00Z","talkEndTime":"2025-02-28T12:15:00Z","trackNumber":1,"tags":[],"videoLinks":[],"complexity":null,"talkId":20006687,"experts":[],"hosts":[],"technicalTags":[],"type":"talk","scope":"regular","topics":[["Студенческий день",1]],"isServiceTalk":false,"partners":[]},{"id":"aa356d242b8844af918d2da3a0d69629","name":{"ru":"Странные ограничения статических компиляторов","en":"-"},"talkOrder":100,"shortDescription":{"ru":"<p>Рассмотрим, чем статически компилируемые языки отличаются от динамически компилируемых, что такое трансляционная семантика, чем трансляция отличается от исполнения и какие странные ограничения статических компиляторов это порождает.</p>","en":"<p>-</p>"},"longDescription":{"ru":"<p>Рассмотрим, чем статически компилируемые языки отличаются от динамически компилируемых, что такое трансляционная семантика, чем трансляция отличается от исполнения и какие странные ограничения статических компиляторов это порождает.</p>","en":"<p>-</p>"},"isRussianLanguage":true,"speakers":[{"id":"8b26d264c5404514b0e9ce278642a97b","name":{"ru":"Константин Владимиров","en":"Константин Владимиров"},"personRating":100,"company":{"ru":"Syntacore","en":"Syntacore"},"bio":{"ru":"<p>Занимаюсь программированием более 20 лет, из них более 15 &mdash; компиляторами.</p>","en":"<p>Занимаюсь программированием более 20 лет, из них более 15 &mdash; компиляторами.</p>"},"speaker":false,"committee":false,"photo":{"id":"16d1f8b9-5adc-4f97-a23f-9b0e9044bd42","title":"Константин Владимиров.jpg","url":"/squidex/srm/16d1f8b9-5adc-4f97-a23f-9b0e9044bd42/konstantin-vladimirov.jpg","fileName":"Константин Владимиров.jpg","contentType":"image/jpeg","details":{"image":{"width":644,"height":644}}},"contacts":[],"achievements":null,"isPartner":false,"contributorId":22007075}],"ogImage":{"ru":{"id":"18d79031-9258-404b-a430-3a3ab7d71b9f","title":"Странные ограничения статических компиляторов_Og_speaker_ru.jpg","url":"/squidex/srm/18d79031-9258-404b-a430-3a3ab7d71b9f/strannye-ogranicheniya-staticheskih-kompilyatorov-og-speaker-ru.jpg","fileName":"Странные ограничения статических компиляторов_Og_speaker_ru.jpg","contentType":"image/jpeg","details":{"image":{"width":1920,"height":862}}},"en":{"id":"18d79031-9258-404b-a430-3a3ab7d71b9f","title":"Странные ограничения статических компиляторов_Og_speaker_ru.jpg","url":"/squidex/srm/18d79031-9258-404b-a430-3a3ab7d71b9f/strannye-ogranicheniya-staticheskih-kompilyatorov-og-speaker-ru.jpg","fileName":"Странные ограничения статических компиляторов_Og_speaker_ru.jpg","contentType":"image/jpeg","details":{"image":{"width":1920,"height":862}}}},"talkDay":1,"time":"2025-02-28T10:15:00Z","talkStartTime":"2025-02-28T10:15:00Z","talkEndTime":"2025-02-28T11:00:00Z","trackNumber":1,"tags":[],"videoLinks":[],"complexity":null,"talkId":20006880,"experts":[],"hosts":[],"technicalTags":[],"type":"talk","scope":"regular","topics":[["Студенческий день",1]],"isServiceTalk":false,"partners":[]}]]],"useEmbeddedLive":false},"__N_SSG":true}