{"pageProps":{"conferenceInfo":{"project":{"since":"2020","contactUs":{"supportEmail":"support@snowone.ru","partnersEmail":"partners@snowone.ru","schemaId":"700952ab-9532-4efa-ac1b-e193a1881010","schemaName":"srm-project-contacts-facet"},"name":"snowone","title":{"ru":"SnowOne","en":"SnowOne"},"social":[{"name":"youtube","url":"https://www.youtube.com/@JUGNsk"},{"name":"twitter","url":"https://x.com/snowone_conf"},{"name":"telegram","url":"https://t.me/snowone_news"}]},"version":{"eventId":100243,"url":{"ru":"https://snowone.ru/archive/2025/","en":"https://snowone.ru/archive/2025/"},"version":"2025","title":{"ru":"SnowOne 2025","en":"SnowOne 2025"},"description":{"ru":"Content-First Java‑конференция из Сибири","en":"Content-First Java conference from Siberia"},"dates":{"startDate":"2025-02-28T09:00:00Z","endDate":"2025-03-01T15:00:00Z"},"periods":[{"startDate":"2025-02-28T09:00:00Z","endDate":"2025-03-01T15:00:00Z","start":{"ru":{"day":28,"month":"февраля"},"en":{"day":28,"month":"February"}},"end":{"ru":{"day":1,"month":"марта"},"en":{"day":1,"month":"March"}},"label":{"ru":"Новосибирск","en":"Novosibirsk"},"type":"offline"}],"venue":{"ru":{"city":"Новосибирск","title":"МВК «Новосибирск Экспоцентр»","address":"Станционная ул., 104","geolocationLink":null},"en":{"city":"Novosibirsk","title":"Novosibirsk Expocentre","address":"Stancionnaya St., 104","geolocationLink":null}},"hasOffline":true,"hasOnline":false},"marketingTools":{"schemaId":"afb7d3ce-b988-418b-a497-6b407fcad913","gtmId":null,"ymId":null,"subscriptionId":null,"metaDescription":"Главное мероприятие года от Java-сообщества Сибири — 28 февраля–1 марта 2025","schemaName":"conf-site-marketing-tools-facet"},"images":{"standardOg":{"ru":{"id":"996074ef-9c39-47e8-8fc5-608fbe0306f2","title":"SnowOne_og_ru.jpg","url":"/squidex/sites/996074ef-9c39-47e8-8fc5-608fbe0306f2/snowone-og-ru.jpg","fileName":"SnowOne_og_ru.jpg","contentType":"image/jpeg","details":{"image":{"width":1920,"height":862}}},"en":{"id":"996074ef-9c39-47e8-8fc5-608fbe0306f2","title":"SnowOne_og_ru.jpg","url":"/squidex/sites/996074ef-9c39-47e8-8fc5-608fbe0306f2/snowone-og-ru.jpg","fileName":"SnowOne_og_ru.jpg","contentType":"image/jpeg","details":{"image":{"width":1920,"height":862}}}},"heroBackground":{"id":"431b7610-d7ac-477d-8a67-81fd85502fbc","title":"hero_background 1.svg","url":"/squidex/sites/431b7610-d7ac-477d-8a67-81fd85502fbc/hero-background-1.svg","fileName":"hero_background 1.svg","contentType":"image/svg+xml","details":{}},"heroLogo":{"id":"e2b0e826-67dd-4a17-b0d7-fe976422679f","title":"hero_art.svg","url":"/squidex/sites/e2b0e826-67dd-4a17-b0d7-fe976422679f/hero-art.svg","fileName":"hero_art.svg","contentType":"image/svg+xml","details":{}},"headerLogo":{"id":"87845d2b-cc0c-4f67-b63a-1329e02206c1","title":"snowone_header_logo.svg","url":"/squidex/sites/87845d2b-cc0c-4f67-b63a-1329e02206c1/snowone-header-logo.svg","fileName":"snowone_header_logo.svg","contentType":"image/svg+xml","details":{}},"footerLogo":{"id":"0ea6f580-0fe3-4345-92a0-a4806f38a158","title":"snowone_footer_logo.svg","url":"/squidex/sites/0ea6f580-0fe3-4345-92a0-a4806f38a158/snowone-footer-logo.svg","fileName":"snowone_footer_logo.svg","contentType":"image/svg+xml","details":{}},"archiveLogo":{"id":"87845d2b-cc0c-4f67-b63a-1329e02206c1","title":"snowone_header_logo.svg","url":"/squidex/sites/87845d2b-cc0c-4f67-b63a-1329e02206c1/snowone-header-logo.svg","fileName":"snowone_header_logo.svg","contentType":"image/svg+xml","details":{}},"archiveImage":{"id":"5ae368d5-2743-4ef4-bf57-adf5e31e6dce","title":"SnowOne_og_ru_archive.jpg","url":"/squidex/sites/5ae368d5-2743-4ef4-bf57-adf5e31e6dce/snowone-og-ru-archive.jpg","fileName":"SnowOne_og_ru_archive.jpg","contentType":"image/jpeg","details":{"image":{"width":1920,"height":862}}},"subscriptionBannerImage":{"id":"9457e34d-03de-4135-a661-a6e2761f322d","title":"snowone-subscription-bg 1.svg","url":"/squidex/sites/9457e34d-03de-4135-a661-a6e2761f322d/snowone-subscription-bg-1.svg","fileName":"snowone-subscription-bg 1.svg","contentType":"image/svg+xml","details":{}},"partnersBannerImage":{"id":"2ca761e0-62ca-4203-a6bd-a99329b0ac87","title":"partner-snowone.svg","url":"/squidex/sites/2ca761e0-62ca-4203-a6bd-a99329b0ac87/partner-snowone.svg","fileName":"partner-snowone.svg","contentType":"image/svg+xml","details":{}}},"states":{"sectionStates":3542636,"clientStates":442,"scheduleGrouping":["days","timeslots","topics"],"scheduleSettings":["sorting"]},"timestamps":{"static":1790341445629,"data":1790341152421},"status":"archive","currentConferenceName":{"ru":"SnowOne","en":"SnowOne"}},"projects":[],"meta":{"title":"SnowOne 2025 | Спикеры | У Java-сообщества Сибири есть традиция: раз в год собираемся офлайн в Новосибирске и говорим про Java и JVM — это то, что мы любим, практикуем, хотим и можем развивать.","description":"Спикеры конференции SnowOne 2025."},"localeConfig":{"locales":["ru"],"defaultLocale":"ru"},"locale":"ru","speakers":[{"id":"db5c5b4aba884410896bfabbe8c1b8af","name":{"ru":"Александр Ланцов","en":"Aleksander Lantsov"},"personRating":100,"company":{"ru":"Мир Plat.Form","en":"Mir Plat.Form"},"bio":{"ru":"<p>В 2014 году окончил МФТИ и начал карьеру в качестве разработчика финансового ПО для трейдеров в крупном инвестиционном банке, где получил первый опыт работы с высоконагруженными системами. Более 5 лет посвятил созданию и развитию алготрейдинговых систем, повышая экспертность в low-latency технологиях и многопоточности.</p>\n<p>Сейчас работаю в Мир Plat.Form, где отвечаю за разработку и оптимизацию производительности одного из ключевых компонентов платежной системы &laquo;Мир&raquo; &mdash; клиринга финансовых операций.</p>","en":"<p>In 2014, I graduated from the Moscow Institute of Physics and Technology and began my career as a financial software developer for traders at a major investment bank, where I gained my first experience with high-load systems. For over five years, I specialized in designing and improving algorithmic trading systems, deepening my expertise in low-latency technologies and multithreading.</p>\n<p>Currently, I work at Mir Plat.Form, where I'm responsible for developing and optimizing the performance of one of the core components of the Mir payment system &mdash; financial transaction clearing.</p>"},"speaker":false,"committee":false,"photo":{"id":"7c27a1aa-7583-4e75-849e-29ae53b07dfa","title":"OMG_1762(1).jpg","url":"/squidex/srm/7c27a1aa-7583-4e75-849e-29ae53b07dfa/omg-1762-1-.jpg","fileName":"OMG_1762(1).jpg","contentType":"image/png","details":{"image":{"width":1598,"height":1435}}},"contacts":[],"achievements":null,"isPartner":false,"contributorId":22003844},{"id":"c8e12b7f645648139745675d357121e4","name":{"ru":"Александр Никитин","en":"- -"},"personRating":100,"company":{"ru":"DBA Team","en":"-"},"bio":{"ru":"<p>Работаю с базами данных. Когда-то специализировался на Oracle, но уже довольно давно перешел на работу с PostgreSQL. Состою в Программном комитете конференции PG BootCamp.</p>\n<p>Занимаюсь гиревым спортом.</p>\n<p>&nbsp;</p>","en":"<p>-</p>"},"speaker":false,"committee":false,"photo":{"id":"d68672ed-c3d3-43ee-a9f6-043794b1206b","title":"BUCTl-eFkqw.jpg","url":"/squidex/srm/d68672ed-c3d3-43ee-a9f6-043794b1206b/buctl-efkqw.jpg","fileName":"BUCTl-eFkqw.jpg","contentType":"image/png","details":{"image":{"width":494,"height":446}}},"contacts":[],"achievements":null,"isPartner":false,"position":{"ru":"ДБА / Генеральный директор","en":"ДБА / Генеральный директор"},"contributorId":22007397},{"id":"35d1d17a70ce4c6e86f13aa230956ebc","name":{"ru":"Пётр Портнов","en":"- -"},"personRating":100,"company":{"ru":"Ozon","en":"-"},"bio":{"ru":"<p>Оканчиваю специалитет по &laquo;Компьютерной безопасности&raquo;. Старший разработчик поисковой платформы Ozon, много пишу на Java. В свободное (и не только) время много опенсорсю на Rust, а также занимаюсь его евангелизмом.</p>\n<p>Люблю рассказывать людям интересное и упоротое в не менее интересной и упоротой манере. Спикер JPoint, Joker и Saint Highload++ 2024.</p>","en":"<p>-</p>"},"speaker":false,"committee":false,"photo":{"id":"012542f4-547b-4b7d-ac43-614d393cb01a","title":"petyaX.jpg","url":"/squidex/srm/012542f4-547b-4b7d-ac43-614d393cb01a/petyax.jpg","fileName":"petyaX.jpg","contentType":"image/png","details":{"image":{"width":557,"height":531}}},"contacts":[],"achievements":null,"isPartner":false,"contributorId":22005567},{"id":"daf6467928ee48b395a0f252bfe67c5d","name":{"ru":"Илья Гаврилин","en":"- -"},"personRating":100,"company":{"ru":"Syntacore","en":"-"},"bio":{"ru":"<p>В Syntacore занимаюсь оптимизацией managed языков. Оптимизировал математические функции в OpenJDK. Соавтор порта компилятора Maglev на RISC-V.</p>","en":"<p>-</p>"},"speaker":false,"committee":false,"photo":{"id":"ed257f74-5654-4764-b196-79a72b892faa","title":"ava.jpg","url":"/squidex/srm/ed257f74-5654-4764-b196-79a72b892faa/ava.jpg","fileName":"ava.jpg","contentType":"image/png","details":{"image":{"width":433,"height":389}}},"contacts":[],"achievements":null,"isPartner":false,"contributorId":22001136},{"id":"d059151d9f1044ec92045be06a20871f","name":{"ru":"Роман Артемьев","en":"Роман Артемьев"},"personRating":100,"company":{"ru":"Syntacore","en":"Syntacore"},"bio":{"ru":"<p>VM/Compiler engineer. Люблю системное программирование, ОС, компиляторы и всякую черную магию вокруг. Занимаюсь Android Runtime.</p>","en":"<p>VM/Compiler engineer. Люблю системное программирование, ОС, компиляторы и всякую черную магию вокруг. Занимаюсь Android Runtime.</p>"},"speaker":false,"committee":false,"photo":{"id":"52e7696f-40e2-4ff3-b562-1abdacde5ac1","title":"photo_2025-01-17 10.07.57.jpeg","url":"/squidex/srm/52e7696f-40e2-4ff3-b562-1abdacde5ac1/photo-2025-01-17-10.07.57.jpeg","fileName":"photo_2025-01-17 10.07.57.jpeg","contentType":"image/png","details":{"image":{"width":612,"height":595}}},"contacts":[],"achievements":null,"isPartner":false,"contributorId":22000370},{"id":"c4d412e1550a4cd4af0e7ea7a60ec0dc","name":{"ru":"Михаил Поливаха","en":"- -"},"personRating":100,"company":{"ru":"Сбер","en":"-"},"bio":{"ru":"<p>Эксперт сообщества <a href=\"https://t.me/spring_aio\">Spring АйО</a>, спикер конференций JPoint, Joker, Kuber Conf. Коммитер Spring Data, активный участник open source-проектов. Профессиональный писатель на <a href=\"https://www.baeldung.com/author/polivakhamikhail\">Baeldung</a>.</p>","en":"<p>-</p>"},"speaker":false,"committee":false,"photo":{"id":"7ef81a39-f4f1-4075-aaa7-444fc82534bb","title":"dev.jpg","url":"/squidex/srm/7ef81a39-f4f1-4075-aaa7-444fc82534bb/dev.jpg","fileName":"dev.jpg","contentType":"image/png","details":{"image":{"width":480,"height":448}}},"contacts":[],"achievements":null,"isPartner":false,"contributorId":22001518},{"id":"8b26d264c5404514b0e9ce278642a97b","name":{"ru":"Константин Владимиров","en":"Константин Владимиров"},"personRating":100,"company":{"ru":"Syntacore","en":"Syntacore"},"bio":{"ru":"<p>Занимаюсь программированием более 20 лет, из них более 15 &mdash; компиляторами.</p>","en":"<p>Занимаюсь программированием более 20 лет, из них более 15 &mdash; компиляторами.</p>"},"speaker":false,"committee":false,"photo":{"id":"16d1f8b9-5adc-4f97-a23f-9b0e9044bd42","title":"Константин Владимиров.jpg","url":"/squidex/srm/16d1f8b9-5adc-4f97-a23f-9b0e9044bd42/konstantin-vladimirov.jpg","fileName":"Константин Владимиров.jpg","contentType":"image/jpeg","details":{"image":{"width":644,"height":644}}},"contacts":[],"achievements":null,"isPartner":false,"contributorId":22007075},{"id":"a7d089812b964df7baee040ff4bb239f","name":{"ru":"Павел Кислов","en":"Pavel Kislov"},"personRating":100,"company":{"ru":"Spring АйО","en":"Spring АйО"},"bio":{"ru":"<p>Я уже около 8 лет в Java. В свободное время преподаю ее, стараюсь нести язык в массы. Эксперт русскоязычного сегмента сообщества Spring Framework.</p>","en":"<p>Я уже около 8 лет в Java. В свободное время преподаю ее, стараюсь нести язык в массы. Эксперт русскоязычного сегмента сообщества Spring Framework.</p>"},"speaker":false,"committee":false,"photo":{"id":"7c9c2681-2d10-43db-845b-8c7a69ed65e3","title":"Павел Кислов.png","url":"/squidex/srm/7c9c2681-2d10-43db-845b-8c7a69ed65e3/pavel-kislov.png","fileName":"Павел Кислов.png","contentType":"image/png","details":{"image":{"width":220,"height":194}}},"contacts":[],"achievements":null,"isPartner":false,"contributorId":22002807},{"id":"bc354f2a7d8c44dfa16f9c1644631a42","name":{"ru":"Роман Елизаров","en":"- -"},"personRating":100,"company":{"ru":"Яндекс","en":"-"},"bio":{"ru":"<p>Эксперт по многопоточности и распределенному программированию, преподаю тематический курс в ИТМО в Санкт-Петербурге.</p>\n<p>15 лет разрабатывал высоконагруженные системы для бирж и брокеров в Devexperts, преимущественно используя Java. В недавнем прошлом 7 лет работал в JetBrains, где возглавлял команду, работающую над языком Kotlin, фокусируясь на дизайне языка и библиотек. Автор корутин в Kotlin &mdash; механизма для асинхронных вычислений.</p>\n<p>Сейчас руковожу отделом улучшения опыта разработки в бизнес-группе Екома и Райдтеха Яндекса, где отвечаю за удобство работы и счастье разработчиков.</p>","en":"<p>-</p>"},"speaker":false,"committee":false,"photo":{"id":"8929fb89-372a-4ad5-8746-ebf90a2d28c8","title":"Roman.Elizarov.jpg","url":"/squidex/srm/8929fb89-372a-4ad5-8746-ebf90a2d28c8/roman.elizarov.jpg","fileName":"Roman.Elizarov.jpg","contentType":"image/jpeg","details":{"image":{"width":644,"height":644}}},"contacts":[],"achievements":null,"isPartner":false,"contributorId":22000140},{"id":"5ba7be870c264d3586b3f10a0f5b605a","name":{"ru":"Александр Нозик","en":"- -"},"personRating":50,"company":{"ru":"МФТИ","en":"-"},"bio":{"ru":"<p>В школе у меня было три увлечения: настольные ролевые игры, физика и программирование. Когда пришло время выбирать профессию, я выбрал физику, думая, что она интереснее. И не ошибся. Но в результате занимаюсь программированием в физике.</p>\n<p>Преподаю физику, математическую статистику и Kotlin в МФТИ, директор центра научного программирования МФТИ, ex-руководитель направления в JetBrains Research. Имею кандидатскую степень по физике частиц.</p>\n<p>С 2006 года в разработке, в том числе коммерческой. В основном на Java, но с 2017 года в основном на Kotlin. Кроме этого были Python, Groovy, Julia и так далее.</p>\n<p>Стал GDE по Kotlin в 2021-м. Руководитель российской KUG (Kotlin User Group).</p>","en":"<p>-</p>"},"speaker":false,"committee":false,"photo":{"id":"1e052169-a8aa-492b-b889-1943854f78bf","title":"102366_1862017862_Aleksandr_Nozik_Arkhitektura_matematicheskikh_vychisleniy_na_Kotlin. (1).jpg","url":"/squidex/srm/1e052169-a8aa-492b-b889-1943854f78bf/102366-1862017862-aleksandr-nozik-arkhitektura-matematicheskikh-vychisleniy-na-kotlin.-1-.jpg","fileName":"102366_1862017862_Aleksandr_Nozik_Arkhitektura_matematicheskikh_vychisleniy_na_Kotlin. (1).jpg","contentType":"image/png","details":{"image":{"width":1611,"height":1611}}},"contacts":[{"type":"github","value":"https://github.com/altavir"}],"achievements":null,"isPartner":false,"contributorId":22002953},{"id":"b57d656864384a7a80bfb848a8abd530","name":{"ru":"Артём Бояршинов","en":"- -"},"personRating":50,"company":{"ru":"Мир Plat.Form","en":"-"},"bio":{"ru":"<p>Разрабатываю систему быстрых платежей. Был в Программном комитете конференции Podlodka Java Crew первые 4 сезона.</p>","en":"<p>-</p>"},"speaker":false,"committee":false,"photo":{"id":"6d32146b-24b2-4de9-b95f-234f7b517728","title":"VF2_5234.png","url":"/squidex/srm/6d32146b-24b2-4de9-b95f-234f7b517728/vf2-5234.png","fileName":"VF2_5234.png","contentType":"image/png","details":{"image":{"width":722,"height":649}}},"contacts":[],"achievements":null,"isPartner":false,"position":{"ru":"Ведущий разработчик","en":"Ведущий разработчик"},"contributorId":22007100},{"id":"fdaf7c0f66114b0d8f6fb9af039d7e07","name":{"ru":"Николай Шипяков","en":"- -"},"personRating":50,"company":{"ru":"T-Банк","en":"-"},"bio":{"ru":"<p>Ведущий разработчик в T-Банке. Из последнего интересного &mdash; был одним из инициаторов <a href=\"https://meetup.tbank.ru/conference/jvm-day/\" target=\"_blank\" rel=\"noopener noreferrer\">JVM-конференции Т-Банка</a>.</p>\n<p>Отец двух сыновей, и, пожалуй, сейчас это мое основное хобби.</p>","en":"<p>-</p>"},"speaker":false,"committee":false,"photo":{"id":"bc90ec5d-44bc-4469-8262-8b6aeaca0597","title":"photo_2023-09-15 16.13.27.jpeg","url":"/squidex/srm/bc90ec5d-44bc-4469-8262-8b6aeaca0597/photo-2023-09-15-16.13.27.jpeg","fileName":"photo_2023-09-15 16.13.27.jpeg","contentType":"image/png","details":{"image":{"width":399,"height":352}}},"contacts":[],"achievements":null,"isPartner":false,"contributorId":22000471},{"id":"6bec11fe137f4a8694db6d80b79ba100","name":{"ru":"Алексей Овсянников","en":"- -"},"personRating":50,"company":{"ru":"Разумные Электрические Сети","en":"-"},"bio":{"ru":"<p>Работаю в IT 10 лет, веду несколько библиотек. Программирую в основном на Kotlin Multiplatform.</p>","en":"<p>-</p>"},"speaker":false,"committee":false,"photo":{"id":"ef403287-0f8b-41c1-b68e-5731eed5c1d6","title":"IMG_7520.JPG","url":"/squidex/srm/ef403287-0f8b-41c1-b68e-5731eed5c1d6/img-7520.jpg","fileName":"IMG_7520.JPG","contentType":"image/png","details":{"image":{"width":3264,"height":3195}}},"contacts":[],"achievements":null,"isPartner":false,"position":{"ru":"Старший разработчик, Тимлид","en":"Старший разработчик, Тимлид"},"contributorId":22005490},{"id":"ea0bb75595794d4580a6301dc400dcc0","name":{"ru":"Екатерина Шевчук","en":"Екатерина Шевчук"},"personRating":50,"company":{"ru":"Koronatech","en":"ЦФТ"},"bio":{"ru":"<p>Старший инженер-разработчик. Тимлид инфраструктурной команды. Куратор курсов ШИФТ Интенсив в Koronatech, направление &laquo;Java-разработка&raquo;. Участник Программного комитета направления Backend в Koronatech (для внутренних и внешних конференций). Выступала на внешних митапах от своей компании и на SnowOne в 2024 году.</p>","en":"<p>Старший инженер-разработчик. Тимлид инфраструктурной команды. Куратор курсов ШИФТ Интенсив в Koronatech, направление &laquo;Java-разработка&raquo;. Участник Программного комитета направления Backend в Koronatech (для внутренних и внешних конференций). Выступала на внешних митапах от своей компании и на SnowOne в 2024 году.</p>"},"speaker":false,"committee":false,"photo":{"id":"d25e65b6-c12f-4487-99ce-b23d8f8bd0ea","title":"шевчук.jpg","url":"/squidex/srm/d25e65b6-c12f-4487-99ce-b23d8f8bd0ea/shevchuk.jpg","fileName":"шевчук.jpg","contentType":"image/png","details":{"image":{"width":2436,"height":2192}}},"contacts":[],"achievements":null,"isPartner":false,"position":{"ru":"Старший инженер-программист","en":"Старший инженер-программист"},"contributorId":22005413},{"id":"fc59d87325cc4689972614ea55686727","name":{"ru":"Илья Сазонов","en":"- -"},"personRating":50,"company":{"ru":"Spring АйО","en":"-"},"bio":{"ru":"<p>Разработчик. Интересуюсь базами данных и Spring.</p>","en":"<p>-</p>"},"speaker":false,"committee":false,"photo":{"id":"81daad48-5806-4ae5-a982-fec6c2687a23","title":"photo_jug.jpg","url":"/squidex/srm/81daad48-5806-4ae5-a982-fec6c2687a23/photo-jug.jpg","fileName":"photo_jug.jpg","contentType":"image/png","details":{"image":{"width":598,"height":549}}},"contacts":[],"achievements":null,"isPartner":false,"position":{"ru":"Эксперт","en":"Эксперт"},"contributorId":22003712},{"id":"00fc6d2ae1404f0496a573fb0b2daa4e","name":{"ru":"Фёдор Сазонов","en":"- -"},"personRating":50,"company":{"ru":"Spring АйО","en":"-"},"bio":{"ru":"<p>Java-разработчик. За свою карьеру работал как над простым бэкендом для веб-страниц, так и над высоконагруженными серверами для онлайновых многопользовательских мобильных шутеров. Глубоко проникся этой темой и теперь консультирую по созданию игровых решений. Работал в нескольких стартапах, где активно участвовал в выстраивании процессов разработки и доставки продукта до конечных пользователей.</p>","en":"<ul>\n<li></li>\n</ul>\n"},"speaker":false,"committee":false,"photo":{"id":"df52ae21-d629-440f-8146-005f5eacef3b","title":"Федор Сазонов_EDITED.jpg","url":"/squidex/srm/df52ae21-d629-440f-8146-005f5eacef3b/fedor-sazonov-edited.jpg","fileName":"Федор Сазонов_EDITED.jpg","contentType":"image/png","details":{"image":{"width":1731,"height":1557}}},"contacts":[{"type":"github","value":"https://github.com/revenant20"}],"achievements":null,"isPartner":false,"position":{"ru":"Эксперт","en":"Эксперт"},"contributorId":22006346},{"id":"829122db38de4594b9ecbd016663124f","name":{"ru":"Сергей Петрелевич","en":"- -"},"personRating":50,"company":{"ru":"SQUAD","en":"-"},"bio":{"ru":"<p>Занимаюсь разработкой больше 20 лет. Интересуюсь многопоточностью, асинхронным программированием, базами данных да и многим другим... Сейчас разрабатываю систему для защиты REST API.</p>","en":"<p>-</p>"},"speaker":false,"committee":false,"photo":{"id":"fbaaad19-eabe-429c-9112-140f05506462","title":"2023_08_23_lofthall4_537_small.jpg","url":"/squidex/srm/fbaaad19-eabe-429c-9112-140f05506462/2023-08-23-lofthall4-537-small.jpg","fileName":"2023_08_23_lofthall4_537_small.jpg","contentType":"image/png","details":{"image":{"width":1511,"height":1368}}},"contacts":[],"achievements":null,"isPartner":false,"position":{"ru":"Техлид","en":"Техлид"},"contributorId":22005938},{"id":"a3702b7fd04d4d25abc87f9be5434582","name":{"ru":"Дмитрий Черкасов","en":"Дмитрий Черкасов"},"personRating":50,"company":{"ru":"Haulmont","en":"Haulmont"},"bio":{"ru":"<p>DevRel Jmix, один из старших разработчиков Jmix. Выступаю на разных конференциях, нравится изучать что-то новое в Java и JVM, рассказывать про что-то новое. Играю на электрогитарах, писал плагин под ASIO на Rust для электрогитар.</p>","en":"<p>DevRel Jmix, один из старших разработчиков Jmix. Выступаю на разных конференциях, нравится изучать что-то новое в Java и JVM, рассказывать про что-то новое. Играю на электрогитарах, писал плагин под ASIO на Rust для электрогитар.</p>"},"speaker":false,"committee":false,"photo":{"id":"ee5ec210-bbca-47e3-a72a-e682c70cf5f7","title":"Дмитрий Черкасов.png","url":"/squidex/srm/ee5ec210-bbca-47e3-a72a-e682c70cf5f7/dmitrii-cherkasov.png","fileName":"Дмитрий Черкасов.png","contentType":"image/png","details":{"image":{"width":282,"height":282}}},"contacts":[],"achievements":null,"isPartner":false,"contributorId":22002486},{"id":"be5ee0b09db34124b248dda1a6f0eff5","name":{"ru":"Настя Лисицкая","en":"Настя Лисицкая"},"personRating":50,"company":{"ru":"Яндекс","en":"Яндекс"},"bio":{"ru":"<p>Уже давненько в Яндексе. Сейчас тимлид команды в Алисе. Развиваем сценарии продуктивности: календарь, будильники, таймеры, напоминания и т. д.</p>","en":"<p>Уже давненько в Яндексе. Сейчас тимлид команды в Алисе. Развиваем сценарии продуктивности: календарь, будильники, таймеры, напоминания и т. д.</p>"},"speaker":false,"committee":false,"photo":{"id":"1fa93bd4-a690-442a-ae39-badce207dee0","title":"Настя Лисицкая.jpg","url":"/squidex/srm/1fa93bd4-a690-442a-ae39-badce207dee0/nastya-lisickaya.jpg","fileName":"Настя Лисицкая.jpg","contentType":"image/jpeg","details":{"image":{"width":644,"height":644}}},"contacts":[],"achievements":null,"isPartner":false,"contributorId":22005364},{"id":"67ad6b1eee8d4b36b3cae9e23aaf75d8","name":{"ru":"Александр Чесноков","en":"Александр Чесноков"},"personRating":50,"company":{"ru":"МФТИ / СберТех","en":"МФТИ / СберТех"},"bio":{"ru":"<p>Учусь в МФТИ, на кафедре СберТеха. Работаю в СберТехе в команде Platform V DataGrid, занимаюсь разработкой высоконагруженных систем и оптимизацией платформенных решений. Ассистент на курсе по Java на кафедре Алгоритмов и Технологий Программирования МФТИ.</p>","en":"<p>Учусь в МФТИ, на кафедре СберТеха. Работаю в СберТехе в команде Platform V DataGrid, занимаюсь разработкой высоконагруженных систем и оптимизацией платформенных решений. Ассистент на курсе по Java на кафедре Алгоритмов и Технологий Программирования МФТИ.</p>"},"speaker":false,"committee":false,"photo":{"id":"3a4a6959-0313-44b3-a841-f1afd0204931","title":"Александр Чесноков.png","url":"/squidex/srm/3a4a6959-0313-44b3-a841-f1afd0204931/aleksandr-chesnokov.png","fileName":"Александр Чесноков.png","contentType":"image/png","details":{"image":{"width":253,"height":259}}},"contacts":[],"achievements":null,"isPartner":false,"contributorId":22004215}]},"__N_SSG":true}