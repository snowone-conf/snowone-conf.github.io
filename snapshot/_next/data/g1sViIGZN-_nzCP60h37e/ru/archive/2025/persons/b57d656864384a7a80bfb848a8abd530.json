ates":1298,"scheduleGrouping":["days"],"scheduleSettings":["sorting"]},"currentConferenceName":{"ru":"SnowOne","en":"SnowOne"},"timestamps":{"static":1790341488459,"data":1790341322320},"status":"current"}}},"projects":[],"meta":{"title":"Артём Бояршинов на SnowOne 2025","description":"Разрабатываю систему быстрых платежей. Был в Программном комитете конференции Podlodka Java Crew первые 4 сезона."},"localeConfig":{"locales":["ru"],"defaultLocale":"ru"},"locale":"ru","person":{"id":"b57d656864384a7a80bfb848a8abd530","name":{"ru":"Артём Бояршинов","en":"- -"},"personRating":50,"company":{"ru":"Мир Plat.Form","en":"-"},"bio":{"ru":"<p>Разрабатываю систему быстрых платежей. Был в Программном комитете конференции Podlodka Java Crew первые 4 сезона.</p>","en":"<p>-</p>"},"speaker":false,"committee":false,"photo":{"id":"6d32146b-24b2-4de9-b95f-234f7b517728","title":"VF2_5234.png","url":"/squidex/srm/6d32146b-24b2-4de9-b95f-234f7b517728/vf2-5234.png","fileName":"VF2_5234.png","contentType":"image/png","details":{"image":{"width":722,"height":649}}},"contacts":[],"achievements":null,"isPartner":false,"position":{"ru":"Ведущий разработчик","en":"Ведущий разработчик"},"contributorId":22007100},"currentActivities":[{"id":"1a5aab5fa8f142f8b93724f49b39c4a7","name":{"ru":"Fluent API на Java","en":"-"},"talkOrder":50,"shortDescription":{"ru":"<p>Из доклада вы узнаете, почему Fluent API &mdash; это больше чем Builder. Рассмотрим различные приемы проектирования Fluent API на примере популярных библиотек: Spring Security, AssertJ, Awaitility и других. Напишем свой небольшой Fluent API.</p>","en":"<p>-</p>"},"longDescription":{"ru":"<p>Вы замечали, что при использовании одних библиотек вам постоянно приходится копаться в исходниках, штудировать Javadocs, а при использовании других &mdash; код будто сам пишется, и нужные методы выпрыгивают в подсказках IDE? Это происходит из-за разных подходов к проектированию API. Такие API, в которых последовательный вызов методов выстраивается в цепочку, формируя DSL-библиотеки, называются Fluent API.</p>\n<p>Из доклада вы узнаете, почему Fluent API &mdash; это больше чем Builder. Рассмотрим различные приемы проектирования Fluent API на примере популярных библиотек: Spring Security, AssertJ, Awaitility и других. Напишем свой небольшой Fluent API.</p>","en":"<p>-</p>"},"isRussianLanguage":true,"speakers":[{"id":"b57d656864384a7a80bfb848a8abd530","name":{"ru":"Артём Бояршинов","en":"- -"},"personRating":50,"company":{"ru":"Мир Plat.Form","en":"-"},"bio":{"ru":"<p>Разрабатываю систему быстрых платежей. Был в Программном комитете конференции Podlodka Java Crew первые 4 сезона.</p>","en":"<p>-</p>"},"speaker":false,"committee":false,"photo":{"id":"6d32146b-24b2-4de9-b95f-234f7b517728","title":"VF2_5234.png","url":"/squidex/srm/6d32146b-24b2-4de9-b95f-234f7b517728/vf2-5234.png","fileName":"VF2_5234.png","contentType":"image/png","details":{"image":{"width":722,"height":649}}},"contacts":[],"achievements":null,"isPartner":false,"position":{"ru":"Ведущий разработчик","en":"Ведущий разработчик"},"contributorId":22007100}],"ogImage":{"ru":{"id":"d33c59ca-22d9-4355-b22f-0b71613f7b45","title":"Fluent API на Java_Og_speaker_ru.jpg","url":"/squidex/srm/d33c59ca-22d9-4355-b22f-0b71613f7b45/fluent-api-na-java-og-speaker-ru.jpg","fileName":"Fluent API на Java_Og_speaker_ru.jpg","contentType":"image/jpeg","details":{"image":{"width":1920,"height":862}}},"en":{"id":"d33c59ca-22d9-4355-b22f-0b71613f7b45","title":"Fluent API на Java_Og_speaker_ru.jpg","url":"/squidex/srm/d33c59ca-22d9-4355-b22f-0b71613f7b45/fluent-api-na-java-og-speaker-ru.jpg","fileName":"Fluent API на Java_Og_speaker_ru.jpg","contentType":"image/jpeg","details":{"image":{"width":1920,"height":862}}}},"talkDay":2,"time":"2025-03-01T09:45:00Z","talkStartTime":"2025-03-01T09:45:00Z","talkEndTime":"2025-03-01T10:45:00Z","trackNumber":2,"tags":[],"videoLinks":[],"complexity":null,"talkId":20006610,"experts":[],"hosts":[],"technicalTags":[],"type":"talk","scope":"regu