ates":1298,"scheduleGrouping":["days"],"scheduleSettings":["sorting"]},"currentConferenceName":{"ru":"SnowOne","en":"SnowOne"},"timestamps":{"static":1790341412177,"data":1790341322320},"status":"current"}}},"projects":[],"meta":{"title":"Михаил Поливаха на SnowOne 2025","description":"Эксперт сообщества Spring АйО, спикер конференций JPoint, Joker, Kuber Conf. Коммитер Spring Data, активный участник open source-проектов. Профессиональный писатель на Baeldung."},"localeConfig":{"locales":["ru"],"defaultLocale":"ru"},"locale":"ru","person":{"id":"c4d412e1550a4cd4af0e7ea7a60ec0dc","name":{"ru":"Михаил Поливаха","en":"- -"},"personRating":100,"company":{"ru":"Сбер","en":"-"},"bio":{"ru":"<p>Эксперт сообщества <a href=\"https://t.me/spring_aio\">Spring АйО</a>, спикер конференций JPoint, Joker, Kuber Conf. Коммитер Spring Data, активный участник open source-проектов. Профессиональный писатель на <a href=\"https://www.baeldung.com/author/polivakhamikhail\">Baeldung</a>.</p>","en":"<p>-</p>"},"speaker":false,"committee":false,"photo":{"id":"7ef81a39-f4f1-4075-aaa7-444fc82534bb","title":"dev.jpg","url":"/squidex/srm/7ef81a39-f4f1-4075-aaa7-444fc82534bb/dev.jpg","fileName":"dev.jpg","contentType":"image/png","details":{"image":{"width":480,"height":448}}},"contacts":[],"achievements":null,"isPartner":false,"contributorId":22001518},"currentActivities":[{"id":"8981d4dc716e4355a5738a7b37b8821d","name":{"ru":"One ORM to Rule Them All","en":"-"},"talkOrder":100,"shortDescription":{"ru":"<p>Рассмотрим различные ORM-системы, ключевые дизайн-принципы, которые они исповедуют, вытекающие из этого ограничения и возможности и, конечно, потенциальные use-кейсы.</p>","en":"<p>-</p>"},"longDescription":{"ru":"<p>В современном мире достаточно много ORM-систем, с которыми, потенциально, можно работать при взаимодействии с БД. Эти ORM-решения основаны на определенных принципах, где последние определяют дизайн и ограничения той или иной системы. Мы рассмотрим различные ORM-системы, ключевые 