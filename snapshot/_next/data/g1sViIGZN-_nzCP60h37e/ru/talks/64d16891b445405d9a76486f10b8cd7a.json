mage":{"width":1920,"height":862}}},"en":{"id":"edb26feb-627a-49bb-b837-3529baa829af","title":"SnowOne_og_ru.jpg","url":"/squidex/sites/edb26feb-627a-49bb-b837-3529baa829af/snowone-og-ru.jpg","fileName":"SnowOne_og_ru.jpg","contentType":"image/jpeg","details":{"image":{"width":1920,"height":862}}}},"heroBackground":{"id":"431b7610-d7ac-477d-8a67-81fd85502fbc","title":"hero_background 1.svg","url":"/squidex/sites/431b7610-d7ac-477d-8a67-81fd85502fbc/hero-background-1.svg","fileName":"hero_background 1.svg","contentType":"image/svg+xml","details":{}},"heroLogo":{"id":"e2b0e826-67dd-4a17-b0d7-fe976422679f","title":"hero_art.svg","url":"/squidex/sites/e2b0e826-67dd-4a17-b0d7-fe976422679f/hero-art.svg","fileName":"hero_art.svg","contentType":"image/svg+xml","details":{}},"headerLogo":{"id":"87845d2b-cc0c-4f67-b63a-1329e02206c1","title":"snowone_header_logo.svg","url":"/squidex/sites/87845d2b-cc0c-4f67-b63a-1329e02206c1/snowone-header-logo.svg","fileName":"snowone_header_logo.svg","contentType":"image/svg+xml","details":{}},"footerLogo":{"id":"0ea6f580-0fe3-4345-92a0-a4806f38a158","title":"snowone_footer_logo.svg","url":"/squidex/sites/0ea6f580-0fe3-4345-92a0-a4806f38a158/snowone-footer-logo.svg","fileName":"snowone_footer_logo.svg","contentType":"image/svg+xml","details":{}},"subscriptionBannerImage":{"id":"9457e34d-03de-4135-a661-a6e2761f322d","title":"snowone-subscription-bg 1.svg","url":"/squidex/sites/9457e34d-03de-4135-a661-a6e2761f322d/snowone-subscription-bg-1.svg","fileName":"snowone-subscription-bg 1.svg","contentType":"image/svg+xml","details":{}},"partnersBannerImage":{"id":"2ca761e0-62ca-4203-a6bd-a99329b0ac87","title":"partner-snowone.svg","url":"/squidex/sites/2ca761e0-62ca-4203-a6bd-a99329b0ac87/partner-snowone.svg","fileName":"partner-snowone.svg","contentType":"image/svg+xml","details":{}}},"states":{"sectionStates":7741052,"clientStates":1298,"scheduleGrouping":["days"],"scheduleSettings":["sorting"]},"timestamps":{"static":1790344577513,"data":1790344381381},"status":"current"},"projects":[],"meta":{"title":"Кровь, пот и Kafka. Request/reply не больно (почти) | Доклад на SnowOne 2026","description":"Расскажем, как мы построили надежный и предсказуемый request/reply-механизм поверх Kafka, используя только штатную функциональность клиента и брокера."},"localeConfig":{"locales":["ru"],"defaultLocale":"ru"},"locale":"ru","conferenceOptions":{"presentationsFilteringMode":"show_for_all"},"talk":{"id":"64d16891b445405d9a76486f10b8cd7a","name":{"ru":"Кровь, пот и Kafka. Request/reply не больно (почти)","en":"-"},"talkOrder":50,"shortDescription":{"ru":"<p>Расскажем, как мы построили надежный и предсказуемый request/reply-механизм поверх Kafka, используя только штатную функциональность клиента и брокера.</p>","en":"<p>-</p>"},"longDescription":{"ru":"<p>Взаимодействие сервисов через Kafka кажется простой задачей, пока не появляются реальные требования к надежности, порядку обработки сообщений, управлению нагрузкой и exactly-once гарантиями доставки.</p>\n<p>Мы столкнулись с этим в полной мере, когда разрабатывали оркестратор бизнес-процессов, состоящий из множества небольших нод, каждая из которых должна обогащаться данными, принимать решения и в ряде случаев сохранять состояние.</p>\n<p>Расскажем, как мы построили надежный и предсказуемый request/reply-механизм поверх Kafka, используя только штатную функциональность клиента и брокера &mdash; без избыточных инструментов, очередей на БД и сервисных прослоек.</p>\n<p>Поделимся архитектурными решениями, эволюцией подходов и тем, что у нас хорошо сработало, а что &mdash; не очень.</p>\n<p>Разберем разные реализации: от поштучного consume-produce и микробатчевой обработки до полного event-loop'а в стиле consume-transform-produce с использованием транзакций Kafka, параллельной обработки и динамических rate-лимитов.</p>\n<p>Доклад будет интересен тем, кто строит высоконагруженные event-driven системы, ориентированные на надежность, и хочет лучше понять, как извлечь максимум из возможностей Kafka, не усложняя инфраструктуру.</p>","en":"<p>-</p>"},"isRussianLanguage":true,"speakers":[{"id":"1a237cef248b4801b3f4f17d848ddc64","name":{"ru":"Николай Рудопас","en":"- -"},"personRating":50,"company":{"ru":"Т-Банк","en":"-"},"bio":{"ru":"<p>В промышленной разработке с 2013 года. Решал проблемы бизнеса в финтех-, ретейл- и телеком-компаниях.</p>\n<p>Сейчас &mdash; техлид в одной из команд отдела технологий продаж Т-Банка.</p>","en":"<p>-</p>"},"speaker":false,"committee":false,"photo":{"id":"0de46119-a925-4a24-a550-7fdbc8df37bb","title":"17555A7C-4825-41B4-ACBC-B84E23FCD4AB copy.jpg","url":"/squidex/srm/0de46119-a925-4a24-a550-7fdbc8df37bb/17555a7c-4825-41b4-acbc-b84e23fcd4ab-copy.jpg","fileName":"17555A7C-4825-41B4-ACBC-B84E23FCD4AB copy.jpg","contentType":"image/jpeg","details":{"image":{"width":2030,"height":1957}}},"contacts":[{"type":"telegram","value":"https://t.me/nikolai_rudopas"}],"achievements":null,"isPartner":false,"position":{"ru":"Техлид","en":"TechLead"},"contributorId":22008949}],"ogImage":{"ru":{"id":"b7e74ae1-bcf7-494d-b481-0d81f55b19f1","title":"reply не больно (почти_youtube+og_ru.jpg","url":"/squidex/srm/b7e74ae1-bcf7-494d-b481-0d81f55b19f1/reply-ne-bolsno-pochti-youtube-og-ru.jpg","fileName":"reply не больно (почти_youtube+og_ru.jpg","contentType":"image/jpeg","details":{"image":{"width":1920,"height":1080}}},"en":{"id":"b7e74ae1-bcf7-494d-b481-0d81f55b19f1","title":"reply не больно (почти_youtube+og_ru.jpg","url":"/squidex/srm/b7e74ae1-bcf7-494d-b481-0d81f55b19f1/reply-ne-bolsno-pochti-youtube-og-ru.jpg","fileName":"reply не больно (почти_youtube+og_ru.jpg","contentType":"image/jpeg","details":{"image":{"width":1920,"height":1080}}}},"talkDay":2,"time":"2026-02-28T03:15:00Z","talkStartTime":"2026-02-28T03:15:00Z","talkEndTime":"2026-02-28T04:15:00Z","trackNumber":3,"tags":[],"materials":[{"url":"https://github.com/snowone-conf/snowone-conf.github.io/releases/download/slides-2026/10-15-nikolai-rudopas.pdf","materialType":"presentation","fileType":"pdf"}],"videoLinks":[],"complexity":null,"talkId":20009825,"experts":[],"hosts":[],"technicalTags":[],"type":"talk","scope":"regular","topics":[],"isServiceTalk":false,"partners":[],"hall":{"ru":"Конференц-зал №2","en":"Конференц-зал №2"}},"useEmbeddedLive":false},"__N_SSG":true}