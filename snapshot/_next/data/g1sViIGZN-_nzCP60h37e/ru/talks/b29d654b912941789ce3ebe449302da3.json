mage":{"width":1920,"height":862}}},"en":{"id":"edb26feb-627a-49bb-b837-3529baa829af","title":"SnowOne_og_ru.jpg","url":"/squidex/sites/edb26feb-627a-49bb-b837-3529baa829af/snowone-og-ru.jpg","fileName":"SnowOne_og_ru.jpg","contentType":"image/jpeg","details":{"image":{"width":1920,"height":862}}}},"heroBackground":{"id":"431b7610-d7ac-477d-8a67-81fd85502fbc","title":"hero_background 1.svg","url":"/squidex/sites/431b7610-d7ac-477d-8a67-81fd85502fbc/hero-background-1.svg","fileName":"hero_background 1.svg","contentType":"image/svg+xml","details":{}},"heroLogo":{"id":"e2b0e826-67dd-4a17-b0d7-fe976422679f","title":"hero_art.svg","url":"/squidex/sites/e2b0e826-67dd-4a17-b0d7-fe976422679f/hero-art.svg","fileName":"hero_art.svg","contentType":"image/svg+xml","details":{}},"headerLogo":{"id":"87845d2b-cc0c-4f67-b63a-1329e02206c1","title":"snowone_header_logo.svg","url":"/squidex/sites/87845d2b-cc0c-4f67-b63a-1329e02206c1/snowone-header-logo.svg","fileName":"snowone_header_logo.svg","contentType":"image/svg+xml","details":{}},"footerLogo":{"id":"0ea6f580-0fe3-4345-92a0-a4806f38a158","title":"snowone_footer_logo.svg","url":"/squidex/sites/0ea6f580-0fe3-4345-92a0-a4806f38a158/snowone-footer-logo.svg","fileName":"snowone_footer_logo.svg","contentType":"image/svg+xml","details":{}},"subscriptionBannerImage":{"id":"9457e34d-03de-4135-a661-a6e2761f322d","title":"snowone-subscription-bg 1.svg","url":"/squidex/sites/9457e34d-03de-4135-a661-a6e2761f322d/snowone-subscription-bg-1.svg","fileName":"snowone-subscription-bg 1.svg","contentType":"image/svg+xml","details":{}},"partnersBannerImage":{"id":"2ca761e0-62ca-4203-a6bd-a99329b0ac87","title":"partner-snowone.svg","url":"/squidex/sites/2ca761e0-62ca-4203-a6bd-a99329b0ac87/partner-snowone.svg","fileName":"partner-snowone.svg","contentType":"image/svg+xml","details":{}}},"states":{"sectionStates":7741052,"clientStates":1298,"scheduleGrouping":["days"],"scheduleSettings":["sorting"]},"timestamps":{"static":1790344575595,"data":1790344381381},"status":"current"},"projects":[],"meta":{"title":"Генеративные LLM. Как технически реализованы ChatGPT/DeepSeek и прочие языковые модели | Доклад на SnowOne 2026","description":"Расскажу про устройство генеративных LLM и инфраструктуру нейросетей, которые непосредственно работают с текстом и отвечают пользователю на его запросы.&nbsp;"},"localeConfig":{"locales":["ru"],"defaultLocale":"ru"},"locale":"ru","conferenceOptions":{"presentationsFilteringMode":"show_for_all"},"talk":{"id":"b29d654b912941789ce3ebe449302da3","name":{"ru":"Генеративные LLM. Как технически реализованы ChatGPT/DeepSeek и прочие языковые модели","en":"-"},"talkOrder":50,"shortDescription":{"ru":"<p>Расскажу про устройство генеративных LLM и инфраструктуру нейросетей, которые непосредственно работают с текстом и отвечают пользователю на его запросы.&nbsp;</p>","en":"<p>-</p>"},"longDescription":{"ru":"<p>ИИ-ассистенты сегодня &mdash; огромные системы, интегрированные в инфраструктуру интернета, которые умеют распознавать картинки, видео, вести диалог с пользователем.</p>\n<p>В формате &laquo;научпоп&raquo; расскажу про сердце таких систем &mdash; генеративные LLM. А именно &mdash; про их внутреннее устройство и инфраструктуру нейросетей, которые непосредственно работают с текстом и отвечают пользователю на его запросы.&nbsp;</p>\n<p>Разберем, как устроен трансформер (декодерная часть), как масштабировать такие модели и какие проблемы возникают, если мы хотим дать миллионам людей возможность пользоваться нашими моделями. Поговорим о параллелизмах, квантизации, спекулятивном декодинге (Eagle/MTP) и Sparse MoE в моделях размером сотни миллиардов параметров.</p>\n<p>Доклад пройдет в студенческий день.</p>","en":"<p>-</p>"},"isRussianLanguage":true,"speakers":[{"id":"c6b1b752bf7f4012a6857e2787fd8ec7","name":{"ru":"Егор Ершов","en":"- -"},"personRating":50,"company":{"ru":"Яндекс","en":"-"},"bio":{"ru":"<p>Разработчик в команде ускорения инференса YandexGPT. Занимаюсь инференсом и его оптимизацией для LLM. Студент ММФ НГУ.</p>","en":"<p>-</p>"},"speaker":false,"committee":false,"photo":{"id":"baaa5c94-3c3a-497a-8601-c49a9ccf3322","title":"pic1.JPG","url":"/squidex/srm/baaa5c94-3c3a-497a-8601-c49a9ccf3322/pic1.jpg","fileName":"pic1.JPG","contentType":"image/png","details":{"image":{"width":1413,"height":1507}}},"contacts":[{"type":"telegram","value":"https://t.me/Wokzy1"}],"achievements":null,"isPartner":false,"position":{"ru":"Разработчик","en":"-"},"contributorId":22008973}],"ogImage":{"ru":{"id":"81e7f7e7-1572-4d72-857e-3f7200278c49","title":"Генеративные LLM. Как технически реализованы ChatG_youtube+og_ru.jpg","url":"/squidex/srm/81e7f7e7-1572-4d72-857e-3f7200278c49/generativnye-llm.-kak-tehnicheski-realizovany-chatg-youtube-og-ru.jpg","fileName":"Генеративные LLM. Как технически реализованы ChatG_youtube+og_ru.jpg","contentType":"image/jpeg","details":{"image":{"width":1920,"height":1080}}},"en":{"id":"81e7f7e7-1572-4d72-857e-3f7200278c49","title":"Генеративные LLM. Как технически реализованы ChatG_youtube+og_ru.jpg","url":"/squidex/srm/81e7f7e7-1572-4d72-857e-3f7200278c49/generativnye-llm.-kak-tehnicheski-realizovany-chatg-youtube-og-ru.jpg","fileName":"Генеративные LLM. Как технически реализованы ChatG_youtube+og_ru.jpg","contentType":"image/jpeg","details":{"image":{"width":1920,"height":1080}}}},"talkDay":1,"time":"2026-02-27T11:30:00Z","talkStartTime":"2026-02-27T11:30:00Z","talkEndTime":"2026-02-27T12:15:00Z","trackNumber":1,"tags":[],"materials":[{"url":"https://github.com/snowone-conf/snowone-conf.github.io/releases/download/slides-2026/18-30-egor-ershov.pdf","materialType":"presentation","fileType":"pdf"}],"videoLinks":[],"complexity":null,"talkId":20009883,"experts":[],"hosts":[],"technicalTags":[],"type":"talk","scope":"regular","topics":[],"isServiceTalk":false,"partners":[],"hall":{"ru":"Большой конференц-зал","en":"Большой конференц-зал"}},"useEmbeddedLive":false},"__N_SSG":true}