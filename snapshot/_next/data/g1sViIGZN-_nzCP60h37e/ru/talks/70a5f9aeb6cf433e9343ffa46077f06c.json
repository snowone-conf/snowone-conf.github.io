mage":{"width":1920,"height":862}}},"en":{"id":"edb26feb-627a-49bb-b837-3529baa829af","title":"SnowOne_og_ru.jpg","url":"/squidex/sites/edb26feb-627a-49bb-b837-3529baa829af/snowone-og-ru.jpg","fileName":"SnowOne_og_ru.jpg","contentType":"image/jpeg","details":{"image":{"width":1920,"height":862}}}},"heroBackground":{"id":"431b7610-d7ac-477d-8a67-81fd85502fbc","title":"hero_background 1.svg","url":"/squidex/sites/431b7610-d7ac-477d-8a67-81fd85502fbc/hero-background-1.svg","fileName":"hero_background 1.svg","contentType":"image/svg+xml","details":{}},"heroLogo":{"id":"e2b0e826-67dd-4a17-b0d7-fe976422679f","title":"hero_art.svg","url":"/squidex/sites/e2b0e826-67dd-4a17-b0d7-fe976422679f/hero-art.svg","fileName":"hero_art.svg","contentType":"image/svg+xml","details":{}},"headerLogo":{"id":"87845d2b-cc0c-4f67-b63a-1329e02206c1","title":"snowone_header_logo.svg","url":"/squidex/sites/87845d2b-cc0c-4f67-b63a-1329e02206c1/snowone-header-logo.svg","fileName":"snowone_header_logo.svg","contentType":"image/svg+xml","details":{}},"footerLogo":{"id":"0ea6f580-0fe3-4345-92a0-a4806f38a158","title":"snowone_footer_logo.svg","url":"/squidex/sites/0ea6f580-0fe3-4345-92a0-a4806f38a158/snowone-footer-logo.svg","fileName":"snowone_footer_logo.svg","contentType":"image/svg+xml","details":{}},"subscriptionBannerImage":{"id":"9457e34d-03de-4135-a661-a6e2761f322d","title":"snowone-subscription-bg 1.svg","url":"/squidex/sites/9457e34d-03de-4135-a661-a6e2761f322d/snowone-subscription-bg-1.svg","fileName":"snowone-subscription-bg 1.svg","contentType":"image/svg+xml","details":{}},"partnersBannerImage":{"id":"2ca761e0-62ca-4203-a6bd-a99329b0ac87","title":"partner-snowone.svg","url":"/squidex/sites/2ca761e0-62ca-4203-a6bd-a99329b0ac87/partner-snowone.svg","fileName":"partner-snowone.svg","contentType":"image/svg+xml","details":{}}},"states":{"sectionStates":7741052,"clientStates":1298,"scheduleGrouping":["days"],"scheduleSettings":["sorting"]},"timestamps":{"static":1790344572711,"data":1790344381381},"status":"current"},"projects":[],"meta":{"title":"Из оркестрации в хореографию и обратно | Доклад на SnowOne 2026","description":"Хореография часто выбирается по умолчанию при реализации логики, затрагивающей несколько сервисов.\nНа примере реализации финансового перевода расскажу про сильные и слабые стороны хореографии, о проблемах, возникающих по мере развития системы, и о способах их решения, исходя из имеющихся на текущий момент фреймворков и инструментов."},"localeConfig":{"locales":["ru"],"defaultLocale":"ru"},"locale":"ru","conferenceOptions":{"presentationsFilteringMode":"show_for_all"},"talk":{"id":"70a5f9aeb6cf433e9343ffa46077f06c","name":{"ru":"Из оркестрации в хореографию и обратно","en":"-"},"talkOrder":50,"shortDescription":{"ru":"<p>Хореография часто выбирается по умолчанию при реализации логики, затрагивающей несколько сервисов.</p>\n<p>На примере реализации финансового перевода расскажу про сильные и слабые стороны хореографии, о проблемах, возникающих по мере развития системы, и о способах их решения, исходя из имеющихся на текущий момент фреймворков и инструментов.</p>","en":"<p>-</p>"},"longDescription":{"ru":"<p>Хореография часто выбирается по умолчанию при реализации логики, затрагивающей несколько сервисов. На примере реализации финансового перевода расскажу про сильные и слабые стороны хореографии.</p>\n<p>В качестве изначального решения будет выбран типовой подход на базе Spring Boot и Apache Kafka. Приведу ряд проблем, возникающих по мере развития системы, и способы их решения как самостоятельно, так и готовыми системами оркестрации. Цель доклада &mdash; дать материал для более осознанного выбора между хореографией и оркестрацией как на старте проекта, так и по мере его развития.</p>","en":"<p>-</p>"},"isRussianLanguage":true,"speakers":[{"id":"8f6e65add0664555adac0d9680c7e0cb","name":{"ru":"Вячеслав Тихонов","en":"- -"},"personRating":50,"company":{"ru":"Т-Банк","en":"-"},"bio":{"ru":"<p>Со школы увлекся программированием, и с тех пор вся жизнь связана с ИТ. Пробовал самые разные позиции: и инженерные, и менеджерские, но потом понял, что написание систем и приложений &mdash; основная страсть.</p>\n<p>Последние лет десять больше сосредоточен на разработке на JVM-стеке.</p>","en":"<p>-</p>"},"speaker":false,"committee":false,"photo":{"id":"4bce8f55-e4ed-4aed-b2da-6649bb3a1ec2","title":"vat.jpg","url":"/squidex/srm/4bce8f55-e4ed-4aed-b2da-6649bb3a1ec2/vat.jpg","fileName":"vat.jpg","contentType":"image/jpeg","details":{"image":{"width":1993,"height":1993}}},"contacts":[{"type":"telegram","value":"https://t.me/vat78"}],"achievements":null,"isPartner":false,"position":{"ru":"Tech Lead","en":"-"},"contributorId":22006993}],"ogImage":{"ru":{"id":"0bba37c0-6501-4396-9ea3-ef055a6849e6","title":"Из оркестрации в хореографию и обратно_youtube+og_ru.jpg","url":"/squidex/srm/0bba37c0-6501-4396-9ea3-ef055a6849e6/iz-orkestracii-v-horeografiyu-i-obratno-youtube-og-ru.jpg","fileName":"Из оркестрации в хореографию и обратно_youtube+og_ru.jpg","contentType":"image/jpeg","details":{"image":{"width":1920,"height":1080}}},"en":{"id":"0bba37c0-6501-4396-9ea3-ef055a6849e6","title":"Из оркестрации в хореографию и обратно_youtube+og_ru.jpg","url":"/squidex/srm/0bba37c0-6501-4396-9ea3-ef055a6849e6/iz-orkestracii-v-horeografiyu-i-obratno-youtube-og-ru.jpg","fileName":"Из оркестрации в хореографию и обратно_youtube+og_ru.jpg","contentType":"image/jpeg","details":{"image":{"width":1920,"height":1080}}}},"talkDay":2,"time":"2026-02-28T04:40:00Z","talkStartTime":"2026-02-28T04:40:00Z","talkEndTime":"2026-02-28T05:40:00Z","trackNumber":2,"tags":[],"materials":[{"url":"https://github.com/snowone-conf/snowone-conf.github.io/releases/download/slides-2026/28.02-vyacheslav-tihonov.pdf","materialType":"presentation","fileType":"pdf"}],"videoLinks":[],"complexity":null,"talkId":20009644,"experts":[],"hosts":[],"technicalTags":[],"type":"talk","scope":"regular","topics":[],"isServiceTalk":false,"partners":[],"hall":{"ru":"Конференц-