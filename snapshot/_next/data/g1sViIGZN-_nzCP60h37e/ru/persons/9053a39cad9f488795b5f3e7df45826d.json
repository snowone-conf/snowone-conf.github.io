":"image/jpeg","details":{"image":{"width":1920,"height":862}}}},"heroBackground":{"id":"431b7610-d7ac-477d-8a67-81fd85502fbc","title":"hero_background 1.svg","url":"/squidex/sites/431b7610-d7ac-477d-8a67-81fd85502fbc/hero-background-1.svg","fileName":"hero_background 1.svg","contentType":"image/svg+xml","details":{}},"heroLogo":{"id":"e2b0e826-67dd-4a17-b0d7-fe976422679f","title":"hero_art.svg","url":"/squidex/sites/e2b0e826-67dd-4a17-b0d7-fe976422679f/hero-art.svg","fileName":"hero_art.svg","contentType":"image/svg+xml","details":{}},"headerLogo":{"id":"87845d2b-cc0c-4f67-b63a-1329e02206c1","title":"snowone_header_logo.svg","url":"/squidex/sites/87845d2b-cc0c-4f67-b63a-1329e02206c1/snowone-header-logo.svg","fileName":"snowone_header_logo.svg","contentType":"image/svg+xml","details":{}},"footerLogo":{"id":"0ea6f580-0fe3-4345-92a0-a4806f38a158","title":"snowone_footer_logo.svg","url":"/squidex/sites/0ea6f580-0fe3-4345-92a0-a4806f38a158/snowone-footer-logo.svg","fileName":"snowone_footer_logo.svg","contentType":"image/svg+xml","details":{}},"subscriptionBannerImage":{"id":"9457e34d-03de-4135-a661-a6e2761f322d","title":"snowone-subscription-bg 1.svg","url":"/squidex/sites/9457e34d-03de-4135-a661-a6e2761f322d/snowone-subscription-bg-1.svg","fileName":"snowone-subscription-bg 1.svg","contentType":"image/svg+xml","details":{}},"partnersBannerImage":{"id":"2ca761e0-62ca-4203-a6bd-a99329b0ac87","title":"partner-snowone.svg","url":"/squidex/sites/2ca761e0-62ca-4203-a6bd-a99329b0ac87/partner-snowone.svg","fileName":"partner-snowone.svg","contentType":"image/svg+xml","details":{}}},"states":{"sectionStates":7741052,"clientStates":1298,"scheduleGrouping":["days"],"scheduleSettings":["sorting"]},"timestamps":{"static":1790344571899,"data":1790344381381},"status":"current","currentConferenceName":{"ru":"SnowOne","en":"SnowOne"},"archiveInfos":{}},"projects":[],"meta":{"title":"Эмиль Газизов на SnowOne 2026","description":"Работаю в небольшом R&amp;D-стартапе в финтехе на Kotlin, соавтор Kotlin Meta. Очень люблю нетворкинг, в свободное время пилю проект, который должен помочь сделать его более эффективным.\nРаньше занимался активно только Android-разработкой, но сейчас занимаюсь всеми вещами понемногу."},"localeConfig":{"locales":["ru"],"defaultLocale":"ru"},"locale":"ru","person":{"id":"9053a39cad9f488795b5f3e7df45826d","name":{"ru":"Эмиль Газизов","en":"- -"},"personRating":50,"company":{"ru":"Kotlin Meta","en":"-"},"bio":{"ru":"<p>Работаю в небольшом R&amp;D-стартапе в финтехе на Kotlin, соавтор Kotlin Meta. Очень люблю нетворкинг, в свободное время пилю проект, который должен помочь сделать его более эффективным.</p>\n<p>Раньше занимался активно только Android-разработкой, но сейчас занимаюсь всеми вещами понемногу.</p>","en":"<p>-</p>"},"speaker":false,"committee":false,"photo":{"id":"022d4fc8-55d8-4530-9de9-fadcc7fbd116","title":"photo_2026-01-27_14-01-36.jpg","url":"/squidex/srm/022d4fc8-55d8-4530-9de9-fadcc7fbd116/photo-2026-01-27-14-01-36.jpg","fileName":"photo_2026-01-27_14-01-36.jpg","contentType":"image/jpeg","details":{"image":{"width":959,"height":916}}},"contacts":[],"achievements":"-","isPartner":false,"position":{"ru":"Kotlin Developer","en":"Kotlin Developer"},"contributorId":22008207},"currentActivities":[{"id":"d74bec452f0444e1bf74d4a4861bf402","name":{"ru":"Айсберг kotlin.coroutines","en":"-"},"talkOrder":50,"shortDescription":{"ru":"<p>Пройдемся по всем составным частям корутин в Kotlin, не залезая в kotlnx.coroutines.</p>","en":"<p>-</p>"},"longDescription":{"ru":"<p>О чем вы думаете, когда слышите слово «корутина»? Может быть, launch, withContext, coroutineScope? Может быть, по вашему мнению, это «легковесный поток»? Более продвинутые пользователи могут подумать про стейт-машину.</p><p>Пройдемся по всем составным частям корутин в Kotlin, не залезая в kotlinx.coroutines, и поймем, что абсолютно никакой магии в корутинах нет и все механизмы реализованы достаточно просто. В частности, мы рассмотрим, как устроены coroutineContext, Continuation, ContinuationInterceptor, Cancellation и много другого интересного.</p>","en":"<p>-</p>"},"isRussianLanguage":true,"speakers":[{"id":"1ba623dda7574fe8a15e9ace297077b7","name":{"ru":"Александр Соколинский","en":"Alexander Sokolinsky"},"personRating":50,"company":{"ru":"Scientific Programming Center","en":"-"},"bio":{"ru":"<p>My passion is networking with people. I like working on collaborative projects, meeting new people, chatting, and sharing knowledge.</p>\n<p>I make money with programming, but I have other interests too.</p>","en":"<p>-</p>"},"speaker":false,"committee":false,"photo":{"id":"96fd0e4d-afc8-4a40-8bed-15aafd68b94c","title":"telegram-cloud-photo-size-2-2055657346452006944-c.jpg","url":"/squidex/srm/96fd0e4d-afc8-4a40-8bed-15aafd68b94c/telegram-cloud-photo-size-2-2055657346452006944-c.jpg","fileName":"telegram-cloud-photo-size-2-2055657346452006944-c.jpg","contentType":"image/png","details":{"image":{"width":334,"height":328}}},"contacts":[{"type":"telegram","value":"https://t.me/alexmeta"}],"achievements":null,"isPartner":false,"position":{"ru":"R&D Developer","en":"Android developer"},"contributorId":22002473},{"id":"9053a39cad9f488795b5f3e7df45826d","name":{"ru":"Эмиль Газизов","en":"- -"},"personRating":50,"company":{"ru":"Kotlin Meta","en":"-"},"bio":{"ru":"<p>Работаю в небольшом R&amp;D-стартапе в финтехе на Kotlin, соавтор Kotlin Meta. Очень люблю нетворкинг, в свободное время пилю проект, который должен помочь сделать его более эффективным.</p>\n<p>Раньше занимался активно только Android-разработкой, но сейчас занимаюсь всеми вещами понемногу.</p>","en":"<p>-</p>"},"speaker":false,"committee":false,"photo":{"id":"022d4fc8-55d8-4530-9de9-fadcc7fbd116","title":"photo_2026-01-27_14-01-36.jpg","url":"/squidex/srm/022d4fc8-55d8-4530-9de9-fadcc7fbd116/photo-2026-01-27-14-01-36.jpg","fileName":"photo_2026-01-27_14-01-36.jpg","contentType":"image/jpeg","details":{"image":{"width":959,"height":916}}},"contacts":[],"achievements":