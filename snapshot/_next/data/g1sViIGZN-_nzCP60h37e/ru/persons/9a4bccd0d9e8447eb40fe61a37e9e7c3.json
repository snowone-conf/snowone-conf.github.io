rouping":["days","timeslots","topics"],"scheduleSettings":["sorting"]},"currentConferenceName":{"ru":"SnowOne","en":"SnowOne"},"timestamps":{"static":1790344571598,"data":1790344406896},"status":"archive"}}},"projects":[],"meta":{"title":"Сергей Петрелевич на SnowOne 2026","description":"Занимаюсь разработкой больше 20 лет. Интересуюсь многопоточностью, асинхронным программированием, базами данных да и многим другим."},"localeConfig":{"locales":["ru"],"defaultLocale":"ru"},"locale":"ru","person":{"id":"9a4bccd0d9e8447eb40fe61a37e9e7c3","name":{"ru":"Сергей Петрелевич","en":"Sergei Petrelevich"},"personRating":50,"company":{"ru":"Т-Банк","en":"T-Bank"},"bio":{"ru":"<p>Занимаюсь разработкой больше 20 лет. Интересуюсь многопоточностью, асинхронным программированием, базами данных да и многим другим.</p>","en":"<p>I have been involved in development for over 20 years. I'm interested in multithreading, asynchronous programming, databases, and many other things.</p>"},"speaker":false,"committee":false,"photo":{"id":"5a54793b-f5cd-428a-a8a6-56d7ad3b6600","title":"2023_08_23_lofthall4_537_small.jpg","url":"/squidex/srm/5a54793b-f5cd-428a-a8a6-56d7ad3b6600/2023-08-23-lofthall4-537-small.jpg","fileName":"2023_08_23_lofthall4_537_small.jpg","contentType":"image/jpeg","details":{"image":{"width":2663,"height":2666}}},"contacts":[],"achievements":null,"isPartner":false,"position":{"ru":"Java-разработчик","en":"Java Developer"},"contributorId":22005938},"currentActivities":[{"id":"c7b8988c19094a77972ee57c87c4d62d","name":{"ru":"NIO. Как одним потоком обработать множество сетевых запросов","en":"NIO. How to Process Multiple Network Requests in a Single Stream"},"talkOrder":100,"shortDescription":{"ru":"<p>Рассмотрим, как в принципе возможно одним потоком обрабатывать множество сетевых запросов одновременно. Узнаем, в каких случаях есть смысл заниматься этой деятельностью.</p>","en":"<p>We&rsquo;ll discuss how it is possible in principle to process multiple network requests simultaneously in a single stream. We&rsquo;ll find out in which cases it makes sense to engage in this activity.</p>"},"longDescription":{"ru":"<p>В докладе мы на примерах разберем, как в Java одним потоком можно обрабатывать множество сетевых запросов одновременно. Узнаем, в каких случаях есть смысл заниматься этой деятельностью.</p>\n<p>Рассмотрим основные аспекты NIO, включая применение системных вызовов операционной системы. Посмотрим на ситуации, когда применение NIO не только усложняет приложение, но и ухудшает характеристики. Подумаем, что можно с этим сделать и как подобные проблемы решаются в высокоуровневых фреймворках.</p>","en":"<p>We&rsquo;ll discuss how it is possible in principle to process multiple network requests simultaneously in a single stream. We&rsquo;ll find out in which cases it makes sense to engage in this activity.</p>"},"isRussianLanguage":true,"speakers":[{"id":"9a4bccd0d9e8447eb40fe61a37e9e7c3","name":{"ru":"Сергей Петрелевич","en":"Sergei Petrelevich"},"personRating":50,"company":{"ru":"Т-Банк","en":"T-Bank"},"bio":{"ru":"<p>Занимаюсь разработкой больше 20 лет. Интересуюсь многопоточностью, асинхронным программированием, базами данных да и многим другим.</p>","en":"<p>I have been involved in development for over 20 years. I'm interested in multithreading, asynchronous programming, databases, and many other things.</p>"},"speaker":false,"committee":false,"photo":{"id":"5a54793b-f5cd-428a-a8a6-56d7ad3b6600","title":"2023_08_23_lofthall4_537_small.jpg","url":"/squidex/srm/5a54793b-f5cd-428a-a8a6-56d7ad3b6600/2023-08-23-lofthall4-537-small.jpg","fileName":"2023_08_23_lofthall4_537_small.jpg","contentType":"image/jpeg","details":{"image":{"width":2663,"height":2666}}},"contacts":[],"achievements":null,"isPartner":false,"position":{"ru":"Java-разработчик","en":"Java Developer"},"contributorId":22005938}],"talkDay":2,"time":"2026-02-28T08:25:00Z","talkStartTime":"2026-02-28T08:25:00Z","talkEndTime":"2026-02-28T09:25:00Z","trackNumber":1,"tags":[],"materials":[{"url":"https://github.com/snowone-conf/snowone-conf.github.io/releases/download/slides-2026/15-25-sergei-petrelevich.pdf","materialType":"presentation","fileType":"pdf"}],"videoLinks":[],"complexity":null,"talkId":20009637,"experts":[],"hosts":[],"technicalTags":[],"type":"talk","scope":"regular","topics":[],"isServiceTalk":false,"partners":[],"hall":{"ru":"Большой конференц-зал","en":"Большой конференц-зал"}}],"pastActivities":[["2025",[{"activities":[],"talks":[{"id":"0d47f2527506490f93c36220d614d37f","name":{"ru":"Что такое и для чего нужно backpressure?","en":"-"},"talkOrder":50,"shortDescription":{"ru":"<p>Это образовательно-прикладной доклад. На примере WebFlux рассмотрим возможную реализацию backpressure и реализуем основные идеи самостоятельно.</p>","en":"<p>-</p>"},"longDescription":{"ru":"<p>Разберемся, что такое backpressure и для чего оно нужно. Как backpressure уже реализовано в WebFlux и как его можно реализовать самостоятельно.</p>","en":"<p>-</p>"},"isRussianLanguage":true,"speakers":[{"id":"829122db38de4594b9ecbd016663124f","name":{"ru":"Сергей Петрелевич","en":"- -"},"personRating":50,"company":{"ru":"SQUAD","en":"-"},"bio":{"ru":"<p>Занимаюсь разработкой больше 20 лет. Интересуюсь многопоточностью, асинхронным программированием, базами данных да и многим другим... Сейчас разрабатываю систему для защиты REST API.</p>","en":"<p>-</p>"},"speaker":false,"committee":false,"photo":{"id":"fbaaad19-eabe-429c-9112-140f05506462","title":"2023_08_23_lofthall4_537_small.jpg","url":"/squidex/srm/fbaaad19-eabe-429c-9112-140f05506462/2023-08-23-lofthall4-537-small.jpg","fileName":"2023_08_23_lofthall4_537_small.jpg","contentType":"image/png","details":{"image":{"width":1511,"height":1368}}},"contacts":[],"achievements":null,"isPartner":false,"position":{"ru":"Техлид","en":"Техлид"},"contributorId":22005938}],"ogImage":{"ru":{"id":"3cd540b3-fe1a-4cc2-912e-854f93531557","title":"Что такое и для чего нужно backpressure_Og_speaker_ru.jpg","url":"/squidex/srm/3cd540b3-fe1a-4cc2-912e-854f93531557/chto-takoe-i-dlya-chego-nuzhno-backpressure-og-speaker-ru.jpg","fileName":"Что такое и для чего нужно backpressure_Og_speaker_ru.jpg","contentType":"image/jpeg","details":{"image":{"width":1920,"height":862}}},"en":{"id":"3cd540b3-fe1a-4cc2-912e-854f93531557","title":"Что такое и для чего нужно backpressure_Og_speaker_ru.jpg","url":"/squidex/srm/3cd540b3-fe1a-4cc2-912e-854f93531557/chto-takoe-i-dlya-chego-nuzhno-backpressure-og-speaker-ru.jpg","fileName":"Что такое и для чего нужно backpressure_Og_speaker_ru.jpg","contentType":"image/jpeg","details":{"image":{"width":1920,"height":862}}}},"talkDay":2,"time":"2025-03-01T04:45:00Z","talkStartTime":"2025-03-01T04:45:00Z","talkEndTime":"2025-03-01T05:45:00Z","trackNumber":2,"tags":[],"videoLinks":[],"complexity":null,"talkId":20006701,"experts":[],"hosts":[],"technicalTags":[],"type":"talk","scope":"regular","topics":[["Основная программа",2]],"isServiceTalk":false,"partners":[]}],"version":"2025"}]]]},"__N_SSG":true}