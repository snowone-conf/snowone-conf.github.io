mage":{"width":1920,"height":862}}},"en":{"id":"edb26feb-627a-49bb-b837-3529baa829af","title":"SnowOne_og_ru.jpg","url":"/squidex/sites/edb26feb-627a-49bb-b837-3529baa829af/snowone-og-ru.jpg","fileName":"SnowOne_og_ru.jpg","contentType":"image/jpeg","details":{"image":{"width":1920,"height":862}}}},"heroBackground":{"id":"431b7610-d7ac-477d-8a67-81fd85502fbc","title":"hero_background 1.svg","url":"/squidex/sites/431b7610-d7ac-477d-8a67-81fd85502fbc/hero-background-1.svg","fileName":"hero_background 1.svg","contentType":"image/svg+xml","details":{}},"heroLogo":{"id":"e2b0e826-67dd-4a17-b0d7-fe976422679f","title":"hero_art.svg","url":"/squidex/sites/e2b0e826-67dd-4a17-b0d7-fe976422679f/hero-art.svg","fileName":"hero_art.svg","contentType":"image/svg+xml","details":{}},"headerLogo":{"id":"87845d2b-cc0c-4f67-b63a-1329e02206c1","title":"snowone_header_logo.svg","url":"/squidex/sites/87845d2b-cc0c-4f67-b63a-1329e02206c1/snowone-header-logo.svg","fileName":"snowone_header_logo.svg","contentType":"image/svg+xml","details":{}},"footerLogo":{"id":"0ea6f580-0fe3-4345-92a0-a4806f38a158","title":"snowone_footer_logo.svg","url":"/squidex/sites/0ea6f580-0fe3-4345-92a0-a4806f38a158/snowone-footer-logo.svg","fileName":"snowone_footer_logo.svg","contentType":"image/svg+xml","details":{}},"subscriptionBannerImage":{"id":"9457e34d-03de-4135-a661-a6e2761f322d","title":"snowone-subscription-bg 1.svg","url":"/squidex/sites/9457e34d-03de-4135-a661-a6e2761f322d/snowone-subscription-bg-1.svg","fileName":"snowone-subscription-bg 1.svg","contentType":"image/svg+xml","details":{}},"partnersBannerImage":{"id":"2ca761e0-62ca-4203-a6bd-a99329b0ac87","title":"partner-snowone.svg","url":"/squidex/sites/2ca761e0-62ca-4203-a6bd-a99329b0ac87/partner-snowone.svg","fileName":"partner-snowone.svg","contentType":"image/svg+xml","details":{}}},"states":{"sectionStates":7741052,"clientStates":1298,"scheduleGrouping":["days"],"scheduleSettings":["sorting"]},"timestamps":{"static":1790344576800,"data":1790344381381},"status":"current"},"projects":[],"meta":{"title":"Deep Dive into JVM JDI: Capturing Live Execution for Automatic JUnit Test Generation | Доклад на SnowOne 2026","description":"Глубокий технический разбор архитектуры инструмента, который использует Java Debug Interface (JDI) для захвата состояния работающей JVM и автоматического синтеза валидных unit-тестов."},"localeConfig":{"locales":["ru"],"defaultLocale":"ru"},"locale":"ru","conferenceOptions":{"presentationsFilteringMode":"show_for_all"},"talk":{"id":"0ab3f3eba9b644d5b0db0e1071fba8fe","name":{"ru":"Deep Dive into JVM JDI: Capturing Live Execution for Automatic JUnit Test Generation","en":"-"},"talkOrder":50,"shortDescription":{"ru":"<p>Глубокий технический разбор архитектуры инструмента, который использует Java Debug Interface (JDI) для захвата состояния работающей JVM и автоматического синтеза валидных unit-тестов.</p>","en":"<p>-</p>"},"longDescription":{"ru":"<p>Глубокий технический разбор архитектуры инструмента, который использует Java Debug Interface (JDI) для захвата состояния работающей JVM и автоматического синтеза валидных unit-тестов.</p>\n<p>Что будет в докладе:</p>\n<ul>\n<li>Deep Dive в JDI. Подробный рассказ про JDI, преимущества и недостатки, а также как его использовать в нестандартных сценариях для безопасного захвата Heap и Stack Frame в реальном времени.</li>\n<li>Реконструкция объектов. Reverse Engineering JVM-состояния для воссоздания сложных графов объектов.</li>\n<li>Синтез Java-кода. Как превратить сырой дамп памяти в чистый, валидный JUnit-тест.</li>\n<li>Роль LLM. Для решения каких проблем мы используем искусственный интеллект?</li>\n</ul>\n<p>Доклад будет полезен Java-разработчикам, интересующимся внутренним устройством JVM, и всем, кто хочет автоматизировать написание тестов.</p>\n<p>Технологии: Java, JVM, JDI (Java Debug Interface), Mockito, JUnit, LLM.</p>","en":"<p>-</p>"},"isRussianLanguage":true,"speakers":[{"id":"e6d2f30de02643beb583279cd9d68bcb","name":{"ru":"Даниил Степанов","en":"- -"},"personRating":50,"company":{"ru":"Veai","en":"-"},"bio":{"ru":"<p>Кандидат технических наук, работаю преподавателем в ИТМО и компании Veai. Область научных интересов: статический и динамический анализ ПО.</p>\n<p>В Veai, занимающейся разработкой плагина, внедряющего LLM-ассистента в IntelliJ-based IDE, я работаю в R&amp;D-отделе, изучающем формальные методы анализа кода.</p>","en":"<p>-</p>"},"speaker":false,"committee":false,"photo":{"id":"84cfd68f-12ce-4d96-a3ee-3f9c553b4279","title":"photo_2023-06-19_09-47-28.jpg","url":"/squidex/srm/84cfd68f-12ce-4d96-a3ee-3f9c553b4279/photo-2023-06-19-09-47-28.jpg","fileName":"photo_2023-06-19_09-47-28.jpg","contentType":"image/png","details":{"image":{"width":784,"height":835}}},"contacts":[{"type":"telegram","value":"https://t.me/stepanov0995"}],"achievements":null,"isPartner":false,"position":{"ru":"Исследователь-разработчик","en":"-"},"contributorId":22008170}],"ogImage":{"ru":{"id":"e8e0b7cb-7179-4a54-b2e9-fef790e1244a","title":"Deep Dive into JVM JDI_ Capturing Live Execution f_youtube+og_ru.jpg","url":"/squidex/srm/e8e0b7cb-7179-4a54-b2e9-fef790e1244a/deep-dive-into-jvm-jdi-capturing-live-execution-f-youtube-og-ru.jpg","fileName":"Deep Dive into JVM JDI_ Capturing Live Execution f_youtube+og_ru.jpg","contentType":"image/jpeg","details":{"image":{"width":1920,"height":1080}}},"en":{"id":"e8e0b7cb-7179-4a54-b2e9-fef790e1244a","title":"Deep Dive into JVM JDI_ Capturing Live Execution f_youtube+og_ru.jpg","url":"/squidex/srm/e8e0b7cb-7179-4a54-b2e9-fef790e1244a/deep-dive-into-jvm-jdi-capturing-live-execution-f-youtube-og-ru.jpg","fileName":"Deep Dive into JVM JDI_ Capturing Live Execution f_youtube+og_ru.jpg","contentType":"image/jpeg","details":{"image":{"width":1920,"height":1080}}}},"talkDay":2,"time":"2026-02-28T07:00:00Z","talkStartTime":"2026-02-28T07:00:00Z","talkEndTime":"2026-02-28T08:00:00Z","trackNumber":1,"tags":[],"materials":[{"url":"https://github.com/snowone-conf/snowone-conf.github.io/re