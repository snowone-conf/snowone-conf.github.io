mage":{"width":1920,"height":862}}},"en":{"id":"edb26feb-627a-49bb-b837-3529baa829af","title":"SnowOne_og_ru.jpg","url":"/squidex/sites/edb26feb-627a-49bb-b837-3529baa829af/snowone-og-ru.jpg","fileName":"SnowOne_og_ru.jpg","contentType":"image/jpeg","details":{"image":{"width":1920,"height":862}}}},"heroBackground":{"id":"431b7610-d7ac-477d-8a67-81fd85502fbc","title":"hero_background 1.svg","url":"/squidex/sites/431b7610-d7ac-477d-8a67-81fd85502fbc/hero-background-1.svg","fileName":"hero_background 1.svg","contentType":"image/svg+xml","details":{}},"heroLogo":{"id":"e2b0e826-67dd-4a17-b0d7-fe976422679f","title":"hero_art.svg","url":"/squidex/sites/e2b0e826-67dd-4a17-b0d7-fe976422679f/hero-art.svg","fileName":"hero_art.svg","contentType":"image/svg+xml","details":{}},"headerLogo":{"id":"87845d2b-cc0c-4f67-b63a-1329e02206c1","title":"snowone_header_logo.svg","url":"/squidex/sites/87845d2b-cc0c-4f67-b63a-1329e02206c1/snowone-header-logo.svg","fileName":"snowone_header_logo.svg","contentType":"image/svg+xml","details":{}},"footerLogo":{"id":"0ea6f580-0fe3-4345-92a0-a4806f38a158","title":"snowone_footer_logo.svg","url":"/squidex/sites/0ea6f580-0fe3-4345-92a0-a4806f38a158/snowone-footer-logo.svg","fileName":"snowone_footer_logo.svg","contentType":"image/svg+xml","details":{}},"subscriptionBannerImage":{"id":"9457e34d-03de-4135-a661-a6e2761f322d","title":"snowone-subscription-bg 1.svg","url":"/squidex/sites/9457e34d-03de-4135-a661-a6e2761f322d/snowone-subscription-bg-1.svg","fileName":"snowone-subscription-bg 1.svg","contentType":"image/svg+xml","details":{}},"partnersBannerImage":{"id":"2ca761e0-62ca-4203-a6bd-a99329b0ac87","title":"partner-snowone.svg","url":"/squidex/sites/2ca761e0-62ca-4203-a6bd-a99329b0ac87/partner-snowone.svg","fileName":"partner-snowone.svg","contentType":"image/svg+xml","details":{}}},"states":{"sectionStates":7741052,"clientStates":1298,"scheduleGrouping":["days"],"scheduleSettings":["sorting"]},"timestamps":{"static":1790344573752,"data":1790344381381},"status":"current"},"projects":[],"meta":{"title":"NIO. Как одним потоком обработать множество сетевых запросов | Доклад на SnowOne 2026","description":"Рассмотрим, как в принципе возможно одним потоком обрабатывать множество сетевых запросов одновременно. Узнаем, в каких случаях есть смысл заниматься этой деятельностью."},"localeConfig":{"locales":["ru"],"defaultLocale":"ru"},"locale":"ru","conferenceOptions":{"presentationsFilteringMode":"show_for_all"},"talk":{"id":"c7b8988c19094a77972ee57c87c4d62d","name":{"ru":"NIO. Как одним потоком обработать множество сетевых запросов","en":"NIO. How to Process Multiple Network Requests in a Single Stream"},"talkOrder":100,"shortDescription":{"ru":"<p>Рассмотрим, как в принципе возможно одним потоком обрабатывать множество сетевых запросов одновременно. Узнаем, в каких случаях есть смысл заниматься этой деятельностью.</p>","en":"<p>We&rsquo;ll discuss how it is possible in principle to process multiple network requests simultaneously in a single stream. We&rsquo;ll find out in which cases it makes sense to engage in this activity.</p>"},"longDescription":{"ru":"<p>В докладе мы на примерах разберем, как в Java одним потоком можно обрабатывать множество сетевых запросов одновременно. Узнаем, в каких случаях есть смысл заниматься этой деятельностью.</p>\n<p>Рассмотрим основные аспекты NIO, включая применение системных вызовов операционной системы. Посмотрим на ситуации, когда применение NIO не только усложняет приложение, но и ухудшает характеристики. Подумаем, что можно с этим сделать и как подобные проблемы решаются в высокоуровневых фреймворках.</p>","en":"<p>We&rsquo;ll discuss how it is possible in principle to process multiple network requests simultaneously in a single stream. We&rsquo;ll find out in which cases it makes sense to engage in this activity.</p>"},"isRussianLanguage":true,"speakers":[{"id":"9a4bccd0d9e8447eb40fe61a37e9e7c3","name":{"ru":"Сергей Петрелевич","en":"Sergei Petrelevich"},"personRating":50,"company":{"ru":"Т-Банк","en":"T-Bank"},"bio":{"ru":"<p>Занимаюсь разработкой больше 20 лет. Интересуюсь многопоточностью, асинхронным программированием, базами данных да и многим другим.</p>","en":"<p>I have been involved in development for over 20 years. I'm interested in multithreading, asynchronous programming, databases, and many other things.</p>"},"speaker":false,"committee":false,"photo":{"id":"5a54793b-f5cd-428a-a8a6-56d7ad3b6600","title":"2023_08_23_lofthall4_537_small.jpg","url":"/squidex/srm/5a54793b-f5cd-428a-a8a6-56d7ad3b6600/2023-08-23-lofthall4-537-small.jpg","fileName":"2023_08_23_lofthall4_537_small.jpg","contentType":"image/jpeg","details":{"image":{"width":2663,"height":2666}}},"contacts":[],"achievements":null,"isPartner":false,"position":{"ru":"Java-разработчик","en":"Java Developer"},"contributorId":22005938}],"talkDay":2,"time":"2026-02-28T08:25:00Z","talkStartTime":"2026-02-28T08:25:00Z","talkEndTime":"2026-02-28T09:25:00Z","trackNumber":1,"tags":[],"materials":[{"url":"https://github.com/snowone-conf/snowone-conf.github.io/releases/download/slides-2026/15-25-sergei-petrelevich.pdf","materialType":"presentation","fileType":"pdf"}],"videoLinks":[],"complexity":null,"talkId":20009637,"experts":[],"hosts":[],"technicalTags":[],"type":"talk","scope":"regular","topics":[],"isServiceTalk":false,"partners":[],"hall":{"ru":"Большой конференц-зал","en":"Большой конференц-зал"}},"useEmbeddedLive":false},"__N_SSG":true}