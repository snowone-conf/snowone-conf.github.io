":"snowone-subscription-bg 1.svg","contentType":"image/svg+xml","details":{}},"partnersBannerImage":{"id":"2ca761e0-62ca-4203-a6bd-a99329b0ac87","title":"partner-snowone.svg","url":"/squidex/sites/2ca761e0-62ca-4203-a6bd-a99329b0ac87/partner-snowone.svg","fileName":"partner-snowone.svg","contentType":"image/svg+xml","details":{}}},"states":{"sectionStates":3542636,"clientStates":442,"scheduleGrouping":["days","timeslots","topics"],"scheduleSettings":["sorting"]},"timestamps":{"static":1790344586715,"data":1790344406705},"status":"archive","currentConferenceName":{"ru":"SnowOne","en":"SnowOne"},"media":{"links":[{"title":{"ru":"Snowone 2025 playlist","en":"Snowone 2025 playlist"},"description":{"ru":"Youtube playlist","en":"Youtube playlist"},"list":[{"url":"https://www.youtube.com/playlist?list=PLecWId-JT7S5bmAmqi5WKXYMsbesRw3bN","type":"youtube"}]}],"playlist":{"link":{"ru":"https://www.youtube.com/playlist?list=PLecWId-JT7S5bmAmqi5WKXYMsbesRw3bN","en":"https://www.youtube.com/playlist?list=PLecWId-JT7S5bmAmqi5WKXYMsbesRw3bN"}}}},"projects":[],"meta":{"title":"Открытие второго дня конференции | Доклад на SnowOne 2025","description":"Говорим о расписании, сессиях и активностях. Приходите в зал, чтобы узнать, что вас будет ждать в ближайшее время!"},"localeConfig":{"locales":["ru"],"defaultLocale":"ru"},"locale":"ru","talk":{"id":"52ce9354214c494b8a718995697671c0","name":{"ru":"Открытие второго дня конференции","en":"-"},"talkOrder":50,"shortDescription":{"ru":"<p>Говорим о расписании, сессиях и активностях. Приходите в зал, чтобы узнать, что вас будет ждать в ближайшее время!</p>","en":"<p>-</p>"},"longDescription":{"ru":"<p>Говорим о расписании, сессиях и активностях. Приходите в зал, чтобы узнать, что вас будет ждать в ближайшее время!</p>","en":"<p>-</p>"},"isRussianLanguage":true,"speakers":[],"talkDay":2,"time":"2025-03-01T03:00:00Z","talkStartTime":"2025-03-01T03:00:00Z","talkEndTime":"2025-03-01T03:15:00Z","trackNumber":1,"tags":[],"videoLinks":[],"complexity":null,"talkId":20007410,"experts":[],"hosts":[{"id":"c7f519a685b04655909bd53da19c3ef7","name":{"ru":"Иван Углянский","en":"Ivan Ugliansky"},"personRating":130,"bio":{"ru":"<p>Работал в компании Excelsior c 2011 года, где был одним из разработчиков Excelsior JET: сертифицированной реализации Java SE, основанной на оптимизирующей AOT-компиляции. Сейчас работаю над компиляторами, JVM и новыми языками программирования. В основном занимаюсь рантаймом: GC, загрузкой классов, поддержкой многопоточности, профилированием и т. д.</p>\n<p>Сооснователь и один из лидеров JUGNsk &mdash; официальной Java User Group в Новосибирске. В качестве хобби преподаю курсы по C/C++ в НГУ.</p>","en":"<p>He worked for Excelsior in the Excelsior JET project (Java SE certified implementation based on optimizing AOT compilation). Now he works for Huawei on JVMs, compilers, and new programming languages. He mainly works with runtime: GC, class loading, concurrency maintenance, profiling, and so on.</p>\n<p>He is also the co-founder and co-lead of JUGNsk, an official Java Users Group in Novosibirsk. In his free time, he teaches C/C++ courses at Novosibirsk State University.</p>"},"speaker":false,"committee":false,"photo":{"id":"1u8fr0uaS7sLocTSy8MCZ4","title":"kXjgjPbMYcY.jpg","url":"/squidex/srm/1u8fr0uaS7sLocTSy8MCZ4/kxjgjpbmycy.jpg","fileName":"kXjgjPbMYcY.jpg","contentType":"image/png","details":{"image":{"width":353,"height":346}}},"contacts":[{"type":"github","value":"https://github.com/ugliansky"}],"achievements":null,"isPartner":false,"contributorId":22000214}],"technicalTags":[],"type":"talk","scope":"regular","topics":[],"isServiceTalk":false,"partners":[]},"useEmbeddedLive":false},"__N_SSG":true}