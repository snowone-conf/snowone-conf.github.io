u":"https://smartdataconf.ru/","en":"https://smartdataconf.ru/en/"},"logo":{"id":"e6f0783d-b91c-46c6-be2b-2f113f63c229","title":"smartdata.svg","url":"/squidex/srm/e6f0783d-b91c-46c6-be2b-2f113f63c229/smartdata.svg","fileName":"smartdata.svg","contentType":"image/svg+xml","details":{}},"color":"#44d8b1","stack":{"ru":"Data Engineering","en":"Data Engineering"}},{"project":"tt","title":{"ru":"TechTrain","en":"TechTrain"},"url":{"ru":"https://techtrain.ru/","en":"https://techtrain.ru/"},"logo":{"id":"8349dfdd-d9ed-4be9-9771-007d399c40e9","title":"techtrain.svg","url":"/squidex/srm/8349dfdd-d9ed-4be9-9771-007d399c40e9/techtrain.svg","fileName":"techtrain.svg","contentType":"image/svg+xml","details":{}},"color":"#ff5e29"},{"project":"videotech","title":{"ru":"VideoTech","en":"VideoTech"},"url":{"ru":"https://vtconf.com/","en":"https://vtconf.com/en/"},"logo":{"id":"b28d58c7-2204-4177-b7b9-dd244015638c","title":"videotech.svg","url":"/squidex/srm/b28d58c7-2204-4177-b7b9-dd244015638c/videotech.svg","fileName":"videotech.svg","contentType":"image/svg+xml","details":{}},"color":"#20bdff","stack":{"ru":"Video & Streaming","en":"Video & Streaming"}},{"project":"sysconf","title":{"ru":"sysconf","en":"sysconf"},"url":{"ru":"https://sysconf.pro/","en":"https://sysconf.pro/"},"logo":{"id":"cecf9277-b0dd-4adb-8b66-d748d13ed382","title":"sysconf.svg","url":"/squidex/srm/cecf9277-b0dd-4adb-8b66-d748d13ed382/sysconf.svg","fileName":"sysconf.svg","contentType":"image/svg+xml","details":{}},"color":"#4c5aff","stack":{"ru":"Системное программирование","en":"System programming"}}],"meta":{"title":"Закрытие конференции | Доклад на SnowOne 2025","description":"Подводим итоги конференции, вспоминаем яркие моменты и рассказываем о дальнейших планах. Ждем всех в зале!"},"localeConfig":{"locales":["ru"],"defaultLocale":"ru"},"locale":"ru","talk":{"id":"8e80908d3967450196a62d374bcc3b9a","name":{"ru":"Закрытие конференции","en":"-"},"talkOrder":50,"shortDescription":{"ru":"<p>Подводим итоги конференции, вспоминаем яркие моменты и рассказываем о дальнейших планах. Ждем всех в зале!</p>","en":"<p>-</p>"},"longDescription":{"ru":"<p>Подводим итоги конференции, вспоминаем яркие моменты и рассказываем о дальнейших планах. Ждем всех в зале!</p>","en":"<p>-</p>"},"isRussianLanguage":true,"speakers":[],"talkDay":2,"time":"2025-03-01T11:00:00Z","talkStartTime":"2025-03-01T11:00:00Z","talkEndTime":"2025-03-01T11:15:00Z","trackNumber":1,"tags":[],"videoLinks":[],"complexity":null,"talkId":20007408,"experts":[],"hosts":[{"id":"c7f519a685b04655909bd53da19c3ef7","name":{"ru":"Иван Углянский","en":"Ivan Ugliansky"},"personRating":130,"bio":{"ru":"<p>Работал в компании Excelsior c 2011 года, где был одним из разработчиков Excelsior JET: сертифицированной реализации Java SE, основанной на оптимизирующей AOT-компиляции. Сейчас работаю над компиляторами, JVM и новыми языками программирования. В основном занимаюсь рантаймом: GC, загрузкой классов, поддержкой многопоточности, профилированием и т. д.</p>\n<p>Сооснователь и один из лидеров JUGNsk &mdash; официальной Java User Group в Новосибирске. В качестве хобби преподаю курсы по C/C++ в НГУ.</p>","en":"<p>He worked for Excelsior in the Excelsior JET project (Java SE certified implementation based on optimizing AOT compilation). Now he works for Huawei on JVMs, compilers, and new programming languages. He mainly works with runtime: GC, class loading, concurrency maintenance, profiling, and so on.</p>\n<p>He is also the co-founder and co-lead of JUGNsk, an official Java Users Group in Novosibirsk. In his free time, he teaches C/C++ courses at Novosibirsk State University.</p>"},"speaker":false,"committee":false,"photo":{"id":"1u8fr0uaS7sLocTSy8MCZ4","title":"kXjgjPbMYcY.jpg","url":"/squidex/srm/1u8fr0uaS7sLocTSy8MCZ4/kxjgjpbmycy.jpg","fileName":"kXjgjPbMYcY.jpg","contentType":"image/png","details":{"image":{"width":353,"height":346}}},"contacts":[{"type":"github","value":"https://github.com/ugliansky"}],"achievements":null,"isPartner":false,"contributorId":22000214}],"technicalTags":[],"type":"talk","scope":"regular","topics":[],"isServiceTalk":false,"partners":[]},"useEmbeddedLive":false},"__N_SSG":true}