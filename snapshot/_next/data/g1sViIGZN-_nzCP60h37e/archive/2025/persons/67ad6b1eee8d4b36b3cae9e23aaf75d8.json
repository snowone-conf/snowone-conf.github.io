ates":1298,"scheduleGrouping":["days"],"scheduleSettings":["sorting"]},"currentConferenceName":{"ru":"SnowOne","en":"SnowOne"},"timestamps":{"static":1790299287090,"data":1790299147555},"status":"current"}}},"projects":[],"meta":{"title":"Александр Чесноков на SnowOne 2025","description":"Учусь в МФТИ, на кафедре СберТеха. Работаю в СберТехе в команде Platform V DataGrid, занимаюсь разработкой высоконагруженных систем и оптимизацией платформенных решений. Ассистент на курсе по Java на кафедре Алгоритмов и Технологий Программирования МФТИ."},"localeConfig":{"locales":["ru"],"defaultLocale":"ru"},"locale":"ru","person":{"id":"67ad6b1eee8d4b36b3cae9e23aaf75d8","name":{"ru":"Александр Чесноков","en":"Александр Чесноков"},"personRating":50,"company":{"ru":"МФТИ / СберТех","en":"МФТИ / СберТех"},"bio":{"ru":"<p>Учусь в МФТИ, на кафедре СберТеха. Работаю в СберТехе в команде Platform V DataGrid, занимаюсь разработкой высоконагруженных систем и оптимизацией платформенных решений. Ассистент на курсе по Java на кафедре Алгоритмов и Технологий Программирования МФТИ.</p>","en":"<p>Учусь в МФТИ, на кафедре СберТеха. Работаю в СберТехе в команде Platform V DataGrid, занимаюсь разработкой высоконагруженных систем и оптимизацией платформенных решений. Ассистент на курсе по Java на кафедре Алгоритмов и Технологий Программирования МФТИ.</p>"},"speaker":false,"committee":false,"photo":{"id":"3a4a6959-0313-44b3-a841-f1afd0204931","title":"Александр Чесноков.png","url":"/squidex/srm/3a4a6959-0313-44b3-a841-f1afd0204931/aleksandr-chesnokov.png","fileName":"Александр Чесноков.png","contentType":"image/png","details":{"image":{"width":253,"height":259}}},"contacts":[],"achievements":null,"isPartner":false,"contributorId":22004215},"currentActivities":[{"id":"7ec8c0897796475ebcb23e2a1bf8e9fe","name":{"ru":"Мудрость из прошлого: как реанимировать забытые проекты","en":"-"},"talkOrder":50,"shortDescription":{"ru":"<p>На примере Java-библиотеки jSymbolic2 расскажу, как дать забытым ценным проектам вторую жизнь, а также какие есть инструменты и методы для эффективного, умного и автоматизированного рефакторинга, которые позволяют не только улучшить качество кода, но и оптимизировать скорость выполнения программы.</p>","en":"<p>-</p>"},"longDescription":{"ru":"<p>В мире open source огромное количество проектов со временем перестают развиваться и уходят в забвение. Однако среди них есть ценные инструменты, которые не так удобны в сборке, запуске и поддержке. В докладе расскажу, как вдохнуть в них новую жизнь на примере библиотеки для анализа нотной музыки jSymbolic2.</p><p>Разберем, какие проблемы приводят к «смерти» проекта, а также подход к системной реанимации с использованием современных инструментов, который позволяет не только улучшить качество и облегчить поддержку кода, но и оптимизировать его производительность</p>","en":"<p>-</p>"},"isRussianLanguage":true,"speakers":[{"id":"67ad6b1eee8d4b36b3cae9e23aaf75d8","name":{"ru":"Александр Чесноков","en":"Александр Чесноков"},"personRating":50,"company":{"ru":"МФТИ / СберТех","en":"МФТИ / СберТех"},"bio":{"ru":"<p>Учусь в МФТИ, на кафедре СберТеха. Работаю в СберТехе в команде Platform V DataGrid, занимаюсь разработкой высоконагруженных систем и оптимизацией платформенных решений. Ассистент на курсе по Java на кафедре Алгоритмов и Технологий Программирования МФТИ.</p>","en":"<p>Учусь в МФТИ, на кафедре СберТеха. Работаю в СберТехе в команде Platform V DataGrid, занимаюсь разработкой высоконагруженных систем и оптимизацией платформенных решений. Ассистент на курсе по Java на кафедре Алгоритмов и Технологий Программирования МФТИ.</p>"},"speaker":false,"committee":false,"photo":{"id":"3a4a6959-0313-44b3-a841-f1afd0204931","title":"Александр Чесноков.png","url":"/squidex/srm/3a4a6959-0313-44b3-a841-f1afd0204931/aleksandr-chesnokov.png","fileName":"Александр Чесноков.png","contentType":"image/png","details":{"image":{"width":253,"height":259}}},"contacts":[],"achievements":null,"isPartner":false,"contributorId"