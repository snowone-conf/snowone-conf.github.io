6feb-627a-49bb-b837-3529baa829af/snowone-og-ru.jpg","fileName":"SnowOne_og_ru.jpg","contentType":"image/jpeg","details":{"image":{"width":1920,"height":862}}},"en":{"id":"edb26feb-627a-49bb-b837-3529baa829af","title":"SnowOne_og_ru.jpg","url":"/squidex/sites/edb26feb-627a-49bb-b837-3529baa829af/snowone-og-ru.jpg","fileName":"SnowOne_og_ru.jpg","contentType":"image/jpeg","details":{"image":{"width":1920,"height":862}}}},"heroBackground":{"id":"431b7610-d7ac-477d-8a67-81fd85502fbc","title":"hero_background 1.svg","url":"/squidex/sites/431b7610-d7ac-477d-8a67-81fd85502fbc/hero-background-1.svg","fileName":"hero_background 1.svg","contentType":"image/svg+xml","details":{}},"heroLogo":{"id":"e2b0e826-67dd-4a17-b0d7-fe976422679f","title":"hero_art.svg","url":"/squidex/sites/e2b0e826-67dd-4a17-b0d7-fe976422679f/hero-art.svg","fileName":"hero_art.svg","contentType":"image/svg+xml","details":{}},"headerLogo":{"id":"87845d2b-cc0c-4f67-b63a-1329e02206c1","title":"snowone_header_logo.svg","url":"/squidex/sites/87845d2b-cc0c-4f67-b63a-1329e02206c1/snowone-header-logo.svg","fileName":"snowone_header_logo.svg","contentType":"image/svg+xml","details":{}},"footerLogo":{"id":"0ea6f580-0fe3-4345-92a0-a4806f38a158","title":"snowone_footer_logo.svg","url":"/squidex/sites/0ea6f580-0fe3-4345-92a0-a4806f38a158/snowone-footer-logo.svg","fileName":"snowone_footer_logo.svg","contentType":"image/svg+xml","details":{}},"subscriptionBannerImage":{"id":"9457e34d-03de-4135-a661-a6e2761f322d","title":"snowone-subscription-bg 1.svg","url":"/squidex/sites/9457e34d-03de-4135-a661-a6e2761f322d/snowone-subscription-bg-1.svg","fileName":"snowone-subscription-bg 1.svg","contentType":"image/svg+xml","details":{}},"partnersBannerImage":{"id":"2ca761e0-62ca-4203-a6bd-a99329b0ac87","title":"partner-snowone.svg","url":"/squidex/sites/2ca761e0-62ca-4203-a6bd-a99329b0ac87/partner-snowone.svg","fileName":"partner-snowone.svg","contentType":"image/svg+xml","details":{}}},"states":{"sectionStates":7741052,"clientStates":1298,"scheduleGrouping":["days"],"scheduleSettings":["sorting"]},"currentConferenceName":{"ru":"SnowOne","en":"SnowOne"},"timestamps":{"static":1790311116163,"data":1790311034578},"status":"current"}}},"projects":[],"meta":{"title":"Николай Шипяков на SnowOne 2025","description":"Ведущий разработчик в T-Банке. Из последнего интересного &mdash; был одним из инициаторов JVM-конференции Т-Банка.\nОтец двух сыновей, и, пожалуй, сейчас это мое основное хобби."},"localeConfig":{"locales":["ru"],"defaultLocale":"ru"},"locale":"ru","person":{"id":"fdaf7c0f66114b0d8f6fb9af039d7e07","name":{"ru":"Николай Шипяков","en":"- -"},"personRating":50,"company":{"ru":"T-Банк","en":"-"},"bio":{"ru":"<p>Ведущий разработчик в T-Банке. Из последнего интересного &mdash; был одним из инициаторов <a href=\"https://meetup.tbank.ru/conference/jvm-day/\" target=\"_blank\" rel=\"noopener noreferrer\">JVM-конференции Т-Банка</a>.</p>\n<p>Отец двух сыновей, и, пожалуй, сейчас это мое основное хобби.</p>","en":"<p>-</p>"},"speaker":false,"committee":false,"photo":{"id":"bc90ec5d-44bc-4469-8262-8b6aeaca0597","title":"photo_2023-09-15 16.13.27.jpeg","url":"/squidex/srm/bc90ec5d-44bc-4469-8262-8b6aeaca0597/photo-2023-09-15-16.13.27.jpeg","fileName":"photo_2023-09-15 16.13.27.jpeg","contentType":"image/png","details":{"image":{"width":399,"height":352}}},"contacts":[],"achievements":null,"isPartner":false,"contributorId":22000471},"currentActivities":[{"id":"10ec21eed12d4b9db2fed576a770f769","name":{"ru":"Интеграционные тесты. Приключение на 5 минут","en":"-"},"talkOrder":50,"shortDescription":{"ru":"<p class=\"ql-align-justify\">Интеграционные тесты &mdash; неотъемлемая часть работы многих инженеров. При первичном погружении в вопрос обычно обнаруживаются статьи и доклады, где надо всего лишь взять Testcontainers, и затем все взлетело и заработало. На самом деле обычно так и есть, если останавливаться на обучающих примерах и дальше не погружаться в вопрос.&nbsp;</p>\n<p class=\"ql-align-justify\">В докладе рассмотрим, какие трудности могут ждать при попытке качественно покрыть функциональность интеграционными тестами реальное, а не учебное приложение.</p>","en":"<p>-</p>"},"longDescription":{"ru":"<p>Интеграционные тесты давно стали привычным инструментом в работе инженеров. Рекомендации по работе с ними зачастую выглядят слишком просто: &laquo;Просто подключите Testcontainers, и все заработает!&raquo;. На учебных примерах это действительно так, но в реальных проектах все далеко не так гладко.</p>\n<p>В докладе на конкретном примере разберем &laquo;типичный&raquo; REST-сервис: с походами в базу данных, HTTP-вызовами внешних сервисов и работой с брокером сообщений. Начнем с полного отсутствия тестов и шаг за шагом итеративно будем дорабатывать их, сталкиваясь все с новыми проблемами.</p>\n<p>В конце оценим пройденный путь и попытаемся этот опыт масштабировать на реальный проект.</p>\n<p>Будет полезно как разработчикам, кто только начинает свой путь с таким типом тестирования, так и тем, кто хочет посмотреть на знакомые задачи под новым углом.</p>","en":"<p>-</p>"},"isRussianLanguage":true,"speakers":[{"id":"fdaf7c0f66114b0d8f6fb9af039d7e07","name":{"ru":"Николай Шипяков","en":"- -"},"personRating":50,"company":{"ru":"T-Банк","en":"-"},"bio":{"ru":"<p>Ведущий разработчик в T-Банке. Из последнего интересного &mdash; был одним из инициаторов <a href=\"https://meetup.tbank.ru/conference/jvm-day/\" target=\"_blank\" rel=\"noopener noreferrer\">JVM-конференции Т-Банка</a>.</p>\n<p>Отец двух сыновей, и, пожалуй, сейчас это мое основное хобби.</p>","en":"<p>-</p>"},"speaker":false,"committee":false,"photo":{"id":"bc90ec5d-44bc-4469-8262-8b6aeaca0597","title":"photo_2023-09-15 16.13.27.jpeg","url":"/squidex/srm/bc90ec5d-44bc-4469-8262-8b6aeaca0597/photo-2023-09-15-16.13.27.jpeg","fileName":"photo_2023-09-15 16.13.27.jpeg","contentType":"image/png","details":{"image":{"width":399,"height":352}}},"contacts":[],"achievements":null,"isPartner":false,"contributorId":22000471}],"ogImage":{"ru":{"id":"60a33d61-1951-407b-be8c-b17a607364e7","title":"Интеграционные тесты. Приключение на 5 минут_Og_speaker_ru.jpg","url":"/squidex/srm/60a33d61-1951-407b-be8c-b17a607364e7/integracionnye-testy.-priklyuchenie-na-5-minut-og-speaker-ru.jpg","fileName":"Интеграционные тесты. Приключение на 5 минут_Og_speaker_ru.jpg","contentType":"image/jpeg","details":{"image":{"width":1920,"height":862}}},"en":{"id":"60a33d61-1951-407b-be8c-b17a607364e7","title":"Интеграционные тесты. Приключение на 5 минут_Og_speaker_ru.jpg","url":"/squidex/srm/60a33d61-1951-407b-be8c-b17a607364e7/integracionnye-testy.-priklyuchenie-na-5-minut-og-speaker-ru.jpg","fileName":"Интеграционные тесты. Приключение на 5 минут_Og_speaker_ru.jpg","contentType":"image/jpeg","details":{"image":{"width":1920,"height":862}}}},"talkDay":2,"time":"2025-03-01T06:45:00Z","talkStartTime":"2025-03-01T06:45:00Z","talkEndTime":"2025-03-01T07:45:00Z","trackNumber":3,"tags":[],"videoLinks":[],"complexity":null,"talkId":20006616,"experts":[],"hosts":[],"technicalTags":[],"type":"talk","scope":"regular","topics":[["Основная программа",2]],"isServiceTalk":false,"partners":[]}],"otherActivities":[]},"__N_SSG":true}