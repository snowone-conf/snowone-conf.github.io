com/","en":"https://vtconf.com/en/"},"logo":{"id":"b28d58c7-2204-4177-b7b9-dd244015638c","title":"videotech.svg","url":"/squidex/srm/b28d58c7-2204-4177-b7b9-dd244015638c/videotech.svg","fileName":"videotech.svg","contentType":"image/svg+xml","details":{}},"color":"#20bdff","stack":{"ru":"Video & Streaming","en":"Video & Streaming"}},{"project":"sysconf","title":{"ru":"sysconf","en":"sysconf"},"url":{"ru":"https://sysconf.pro/","en":"https://sysconf.pro/"},"logo":{"id":"cecf9277-b0dd-4adb-8b66-d748d13ed382","title":"sysconf.svg","url":"/squidex/srm/cecf9277-b0dd-4adb-8b66-d748d13ed382/sysconf.svg","fileName":"sysconf.svg","contentType":"image/svg+xml","details":{}},"color":"#4c5aff","stack":{"ru":"Системное программирование","en":"System programming"}}],"meta":{"title":"Пётр Портнов на SnowOne 2025","description":"Оканчиваю специалитет по &laquo;Компьютерной безопасности&raquo;. Старший разработчик поисковой платформы Ozon, много пишу на Java. В свободное (и не только) время много опенсорсю на Rust, а также занимаюсь его евангелизмом.\nЛюблю рассказывать людям интересное и упоротое в не менее интересной и упоротой манере. Спикер JPoint, Joker и Saint Highload++ 2024."},"localeConfig":{"locales":["ru"],"defaultLocale":"ru"},"locale":"ru","person":{"id":"35d1d17a70ce4c6e86f13aa230956ebc","name":{"ru":"Пётр Портнов","en":"- -"},"personRating":100,"company":{"ru":"Ozon","en":"-"},"bio":{"ru":"<p>Оканчиваю специалитет по &laquo;Компьютерной безопасности&raquo;. Старший разработчик поисковой платформы Ozon, много пишу на Java. В свободное (и не только) время много опенсорсю на Rust, а также занимаюсь его евангелизмом.</p>\n<p>Люблю рассказывать людям интересное и упоротое в не менее интересной и упоротой манере. Спикер JPoint, Joker и Saint Highload++ 2024.</p>","en":"<p>-</p>"},"speaker":false,"committee":false,"photo":{"id":"012542f4-547b-4b7d-ac43-614d393cb01a","title":"petyaX.jpg","url":"/squidex/srm/012542f4-547b-4b7d-ac43-614d393cb01a/petyax.jpg","fileName":"petyaX.jpg","contentType":"image/png","details":{"image":{"width":557,"height":531}}},"contacts":[],"achievements":null,"isPartner":false,"contributorId":22005567},"currentActivities":[{"id":"7fc7bbedf01141a5953e81ccca1cf35e","name":{"ru":"Банальные свичи","en":"-"},"talkOrder":100,"shortDescription":{"ru":"<p>Свичи с разных сторон. Посмотрим, как они эволюционировали, какие ужасы (зачем-то) унаследовали из Ceylon, как устроена нетривиальщина (строки/энамы, pattern matching, exhaustiveness, неудачная реализация в OpenJDK) и чего им еще не хватает для красоты мира.</p>","en":"<p>-</p>"},"longDescription":{"ru":"<p>Свичи с разных сторон. Посмотрим, как они эволюционировали, какие ужасы (зачем-то) унаследовали из Ceylon, как устроена нетривиальщина (строки/энамы, pattern matching, exhaustiveness, неудачная реализация в OpenJDK) и чего им еще не хватает для красоты мира.</p>","en":"<p>-</p>"},"isRussianLanguage":true,"speakers":[{"id":"35d1d17a70ce4c6e86f13aa230956ebc","name":{"ru":"Пётр Портнов","en":"- -"},"personRating":100,"company":{"ru":"Ozon","en":"-"},"bio":{"ru":"<p>Оканчиваю специалитет по &laquo;Компьютерной безопасности&raquo;. Старший разработчик поисковой платформы Ozon, много пишу на Java. В свободное (и не только) время много опенсорсю на Rust, а также занимаюсь его евангелизмом.</p>\n<p>Люблю рассказывать людям интересное и упоротое в не менее интересной и упоротой манере. Спикер JPoint, Joker и Saint Highload++ 2024.</p>","en":"<p>-</p>"},"speaker":false,"committee":false,"photo":{"id":"012542f4-547b-4b7d-ac43-614d393cb01a","title":"petyaX.jpg","url":"/squidex/srm/012542f4-547b-4b7d-ac43-614d393cb01a/petyax.jpg","fileName":"petyaX.jpg","contentType":"image/png","details":{"image":{"width":557,"height":531}}},"contacts":[],"achievements":null,"isPartner":false,"contributorId":22005567}],"ogImage":{"ru":{"id":"e3e85373-a8d0-4135-9b14-040d65951801","title":"Банальные свичи_Og_speaker_ru.jpg","url":"/squidex/srm/e3e85373-a8d0-4135-9b14-040d65951801/banalsnye-svichi-og-speaker-ru.jpg","fileName":"Банальные свичи_Og_speaker_ru.jpg","contentType":"image/jpeg","details":{"image":{"width":1920,"height":862}}},"en":{"id":"e3e85373-a8d0-4135-9b14-040d65951801","title":"Банальные свичи_Og_speaker_ru.jpg","url":"/squidex/srm/e3e85373-a8d0-4135-9b14-040d65951801/banalsnye-svichi-og-speaker-ru.jpg","fileName":"Банальные свичи_Og_speaker_ru.jpg","contentType":"image/jpeg","details":{"image":{"width":1920,"height":862}}}},"talkDay":2,"time":"2025-03-01T03:15:00Z","talkStartTime":"2025-03-01T03:15:00Z","talkEndTime":"2025-03-01T04:15:00Z","trackNumber":1,"tags":[],"videoLinks":[],"complexity":null,"talkId":20006673,"experts":[],"hosts":[],"technicalTags":[],"type":"talk","scope":"regular","topics":[["Основная программа",2]],"isServiceTalk":false,"partners":[]}],"otherActivities":[["2026",[{"activities":[{"id":"f8c9d000342640c788b72468b8522a8f","name":{"ru":"Lightning Talks","en":"Lightning Talks"},"talkOrder":50,"longDescription":{"ru":"<p>Lightning talks &mdash; это отличный формат, чтобы динамично обсудить тему и найти единомышленников. Вас ждут 10-минутные доклады на профессиональные или околопрофессиональные темы и живые обсуждения.&nbsp;</p>\n<p>Давно хотели попробовать себя в роли спикера? Вам не терпится поделиться с миром идеями или кейсами из рабочей практики? Посмотрели выступления SnowOne и чувствуете, что можете добавить к докладам что-то свое? Тогда записывайтесь на выступление прямо на площадке!&nbsp;</p>\n<p><em>Поучаствовать в активности можно, только если у вас есть офлайн-билет на конференцию.</em></p>","en":"<p>Lightning talks &mdash; это отличный формат, чтобы динамично обсудить тему и найти единомышленников. Вас ждут 10-минутные доклады на профессиональные или околопрофессиональные темы и живые обсуждения.&nbsp;</p>\n<p>Давно хотели попробовать себя в роли спикера? Вам не терпится поделиться с миром идеями или кейсами из рабочей практики? Посмотрели выступления SnowOne и чувствуете, что можете добавить к докладам что-то свое? Тогда записывайтесь на выступление прямо на площадке!&nbsp;</p>\n<p>Поучаствовать в активности можно, только если у вас есть офлайн-билет на конференцию.</p>"},"isRussianLanguage":true,"speakers":[],"talkDay":2,"time":"2026-02-28T11:20:00Z","talkStartTime":"2026-02-28T11:20:00Z","talkEndTime":"2026-02-28T13:20:00Z","trackNumber":2,"tags":[],"videoLinks":[],"complexity":null,"talkId":20010253,"experts":[],"hosts":[{"id":"c3bf68a1b40045cd96761440ececaa3e","name":{"ru":"Пётр Портнов","en":"Petr Portnov"},"personRating":100,"company":{"ru":"Ozon","en":"Ozon"},"bio":{"ru":"<p>Ведущий разработчик поисковой платформы в Ozon. Создаю новые технические фичи в поиске, такие как быстрое хранилище атрибутов, оптимизатор поисковых запросов, производительные форматы данных. Улучшаю производительность движка и связанных подсистем. Разрабатываю внутренний тулинг команды, включая анализатор поискового индекса, продвинутый парсер запросов и клиент для управления кластером, а также участвую в разработке Java-платформы.</p>\n<p>Основные языки разработки: Java, Rust.</p>\n<p>Фанат опенсорса, контрибьютил в OpenJDK, Rust, Lucene, one-nio, jrsonnet, Log4j.</p>\n<p>Топлю за строгую типизацию и максимальную статическую верифицируемость кода.</p>\n<p>В свободное время занимаюсь проектами биндинга для Flipper Zero и реализации модульного игрового сервера. Мейнтейню репозиторий nixpkgs, писал квантовый ЯП.</p>\n<p>Ранее работал в геймдеве, создавал игровые серверы и инфраструктуры вокруг них.</p>\n<p>Специалист по защите информации. Читаю курс по алгоритмам в МГТУ и по Java в ИТМО. Спикер и эксперт конференций JPoint, Joker, SnowOne.</p>","en":"<p>Lead developer of the search platform at Ozon. I create new technical features in search, such as fast attribute storage, search query optimizer, and high-performance data formats. I improve the performance of the engine and related subsystems. I develop internal team tools, including a search index analyzer, an advanced query parser, and a cluster management client, and I also participate in the development of the Java platform.</p>\n<p>Main development languages: Java, Rust.</p>\n<p>I am an Open Source enthusiast and have contributed to OpenJDK, Rust, Lucene, one-nio, jrsonnet, and Log4j.</p>\n<p>A proponent of strict typing and maximum static verifiability of code.</p>\n<p>In my spare time, I work on binding projects for Flipper Zero and the implementation of a modular game server. I maintain the nixpkgs repository and wrote a quantum programming language.</p>\n<p>Previously worked in game development, creating game servers and the infrastructure around them.</p>\n<p>Information security specialist. I teach a course on algorithms at MSTU and on Java at ITMO. Speaker and expert at JPoint, Joker, and SnowOne conferences.</p>"},"speaker":false,"committee":false,"photo":{"id":"f379ffd9-681d-49eb-97b3-6aaa7f1f675e","title":"pportnov.png","url":"/squidex/srm/f379ffd9-681d-49eb-97b3-6aaa7f1f675e/pportnov.png","fileName":"pportnov.png","contentType":"image/png","details":{"image":{"width":200,"height":200}}},"contacts":[],"achievements":null,"isPartner":false,"position":{"ru":"Ведущий разработчик","en":"Lead Developer"},"contributorId":22005567}],"technicalTags":["offline_only","no_recording"],"type":"conversation","scope":"regular","topics":[],"isServiceTalk":false,"partners":[],"hall":{"ru":"Конференц-зал №1","en":"Конференц-зал №1"}}],"talks":[{"id":"509a9ae7cc1e43738dfce080df5a19db","name":{"ru":"Ловим баги с Error Prone [18+]","en":"Catching Bugs with Error Prone [18+]"},"talkOrder":100,"shortDescription":{"ru":"<p>Познавательно-рассказывательный доклад, призванный показать Java-разработчикам Error Prone как инструмент для минимизации багов в их коде. Я расскажу про статический анализ, покажу Error Prone как хороший инструмент для статического анализа, а также продемонстрирую, что Error Prone просто расширяем для своих задач.</p>","en":"<p>An informative and narrative session designed to show Java developers Error Prone as a tool for minimizing bugs in their code. I will talk about static analysis, show Error Prone as a good tool for static analysis, and demonstrate that Error Prone can be easily extended for your own tasks.</p>"},"longDescription":{"ru":"<p>Познавательно-рассказывательный доклад, призванный показать Java-разработчикам Error Prone как инструмент для минимизации багов в их коде, простой в использовании и энфорсящий хорошие практики по умолчанию.</p>\n<p>Я расскажу про статический анализ, покажу Error Prone как хороший инструмент для статического анализа, а также продемонстрирую, что Error Prone просто расширяем для своих задач.&nbsp;</p>\n<p>Доклад будет интересен:</p>\n<ul>\n<li>опытным разработчикам, которым Error Prone может принести пользу как инструмент для анализа и улучшения уже существующих проектов;</li>\n<li>продвинутым разработчикам, которые пишут внутренние библиотеки и хотят обеспечить их правильное использование (для этого можно просто написать свой плагин для Error Prone);</li>\n<li>начинающим разработчикам, которым может быть полезно показать удобный инструмент, позволяющий писать более чистый, предсказуемый и поддерживаемый код.</li>\n</ul>","en":"<p>An informative and narrative session designed to show Java developers Error Prone as a tool for minimizing bugs in their code. I will talk about static analysis, show Error Prone as a good tool for static analysis, and demonstrate that Error Prone can be easily extended for your own tasks.</p>"},"isRussianLanguage":true,"speakers":[{"id":"c3bf68a1b40045cd96761440ececaa3e","name":{"ru":"Пётр Портнов","en":"Petr Portnov"},"personRating":100,"company":{"ru":"Ozon","en":"Ozon"},"bio":{"ru":"<p>Ведущий разработчик поисковой платформы в Ozon. Создаю новые технические фичи в поиске, такие как быстрое хранилище атрибутов, оптимизатор поисковых запросов, производительные форматы данных. Улучшаю производительность движка и связанных подсистем. Разрабатываю внутренний тулинг команды, включая анализатор поискового индекса, продвинутый парсер запросов и клиент для управления кластером, а также участвую в разработке Java-платформы.</p>\n<p>Основные языки разработки: Java, Rust.</p>\n<p>Фанат опенсорса, контрибьютил в OpenJDK, Rust, Lucene, one-nio, jrsonnet, Log4j.</p>\n<p>Топлю за строгую типизацию и максимальную статическую верифицируемость кода.</p>\n<p>В свободное время занимаюсь проектами биндинга для Flipper Zero и реализации модульного игрового сервера. Мейнтейню репозиторий nixpkgs, писал квантовый ЯП.</p>\n<p>Ранее работал в геймдеве, создавал игровые серверы и инфраструктуры вокруг них.</p>\n<p>Специалист по защите информации. Читаю курс по алгоритмам в МГТУ и по Java в ИТМО. Спикер и эксперт конференций JPoint, Joker, SnowOne.</p>","en":"<p>Lead developer of the search platform at Ozon. I create new technical features in search, such as fast attribute storage, search query optimizer, and high-performance data formats. I improve the performance of the engine and related subsystems. I develop internal team tools, including a search index analyzer, an advanced query parser, and a cluster management client, and I also participate in the development of the Java platform.</p>\n<p>Main development languages: Java, Rust.</p>\n<p>I am an Open Source enthusiast and have contributed to OpenJDK, Rust, Lucene, one-nio, jrsonnet, and Log4j.</p>\n<p>A proponent of strict typing and maximum static verifiability of code.</p>\n<p>In my spare time, I work on binding projects for Flipper Zero and the implementation of a modular game server. I maintain the nixpkgs repository and wrote a quantum programming language.</p>\n<p>Previously worked in game development, creating game servers and the infrastructure around them.</p>\n<p>Information security specialist. I teach a course on algorithms at MSTU and on Java at ITMO. Speaker and expert at JPoint, Joker, and SnowOne conferences.</p>"},"speaker":false,"committee":false,"photo":{"id":"f379ffd9-681d-49eb-97b3-6aaa7f1f675e","title":"pportnov.png","url":"/squidex/srm/f379ffd9-681d-49eb-97b3-6aaa7f1f675e/pportnov.png","fileName":"pportnov.png","contentType":"image/png","details":{"image":{"width":200,"height":200}}},"contacts":[],"achievements":null,"isPartner":false,"position":{"ru":"Ведущий разработчик","en":"Lead Developer"},"contributorId":22005567}],"talkDay":2,"time":"2026-02-28T03:15:00Z","talkStartTime":"2026-02-28T03:15:00Z","talkEndTime":"2026-02-28T04:15:00Z","trackNumber":2,"tags":[],"materials":[{"url":"https://squidex.jugru.team/api/assets/srm/9beed7bb-4d58-4444-9886-2149bccb440c/snowone-p.-portnov.pdf","materialType":"presentation","fileType":"pdf"}],"videoLinks":[],"complexity":null,"talkId":20009686,"experts":[],"hosts":[],"technicalTags":[],"type":"talk","scope":"regular","topics":[],"isServiceTalk":false,"partners":[],"hall":{"ru":"Конференц-зал №1","en":"Конференц-зал №1"}}],"version":"2026"}]]]},"__N_SSG":true}