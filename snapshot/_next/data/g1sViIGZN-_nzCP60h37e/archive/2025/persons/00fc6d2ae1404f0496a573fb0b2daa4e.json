6feb-627a-49bb-b837-3529baa829af/snowone-og-ru.jpg","fileName":"SnowOne_og_ru.jpg","contentType":"image/jpeg","details":{"image":{"width":1920,"height":862}}},"en":{"id":"edb26feb-627a-49bb-b837-3529baa829af","title":"SnowOne_og_ru.jpg","url":"/squidex/sites/edb26feb-627a-49bb-b837-3529baa829af/snowone-og-ru.jpg","fileName":"SnowOne_og_ru.jpg","contentType":"image/jpeg","details":{"image":{"width":1920,"height":862}}}},"heroBackground":{"id":"431b7610-d7ac-477d-8a67-81fd85502fbc","title":"hero_background 1.svg","url":"/squidex/sites/431b7610-d7ac-477d-8a67-81fd85502fbc/hero-background-1.svg","fileName":"hero_background 1.svg","contentType":"image/svg+xml","details":{}},"heroLogo":{"id":"e2b0e826-67dd-4a17-b0d7-fe976422679f","title":"hero_art.svg","url":"/squidex/sites/e2b0e826-67dd-4a17-b0d7-fe976422679f/hero-art.svg","fileName":"hero_art.svg","contentType":"image/svg+xml","details":{}},"headerLogo":{"id":"87845d2b-cc0c-4f67-b63a-1329e02206c1","title":"snowone_header_logo.svg","url":"/squidex/sites/87845d2b-cc0c-4f67-b63a-1329e02206c1/snowone-header-logo.svg","fileName":"snowone_header_logo.svg","contentType":"image/svg+xml","details":{}},"footerLogo":{"id":"0ea6f580-0fe3-4345-92a0-a4806f38a158","title":"snowone_footer_logo.svg","url":"/squidex/sites/0ea6f580-0fe3-4345-92a0-a4806f38a158/snowone-footer-logo.svg","fileName":"snowone_footer_logo.svg","contentType":"image/svg+xml","details":{}},"subscriptionBannerImage":{"id":"9457e34d-03de-4135-a661-a6e2761f322d","title":"snowone-subscription-bg 1.svg","url":"/squidex/sites/9457e34d-03de-4135-a661-a6e2761f322d/snowone-subscription-bg-1.svg","fileName":"snowone-subscription-bg 1.svg","contentType":"image/svg+xml","details":{}},"partnersBannerImage":{"id":"2ca761e0-62ca-4203-a6bd-a99329b0ac87","title":"partner-snowone.svg","url":"/squidex/sites/2ca761e0-62ca-4203-a6bd-a99329b0ac87/partner-snowone.svg","fileName":"partner-snowone.svg","contentType":"image/svg+xml","details":{}}},"states":{"sectionStates":7741052,"clientStates":1298,"scheduleGrouping":["days"],"scheduleSettings":["sorting"]},"currentConferenceName":{"ru":"SnowOne","en":"SnowOne"},"timestamps":{"static":1790341468783,"data":1790341322320},"status":"current"}}},"projects":[],"meta":{"title":"Фёдор Сазонов на SnowOne 2025","description":"Java-разработчик. За свою карьеру работал как над простым бэкендом для веб-страниц, так и над высоконагруженными серверами для онлайновых многопользовательских мобильных шутеров. Глубоко проникся этой темой и теперь консультирую по созданию игровых решений. Работал в нескольких стартапах, где активно участвовал в выстраивании процессов разработки и доставки продукта до конечных пользователей."},"localeConfig":{"locales":["ru"],"defaultLocale":"ru"},"locale":"ru","person":{"id":"00fc6d2ae1404f0496a573fb0b2daa4e","name":{"ru":"Фёдор Сазонов","en":"- -"},"personRating":50,"company":{"ru":"Spring АйО","en":"-"},"bio":{"ru":"<p>Java-разработчик. За свою карьеру работал как над простым бэкендом для веб-страниц, так и над высоконагруженными серверами для онлайновых многопользовательских мобильных шутеров. Глубоко проникся этой темой и теперь консультирую по созданию игровых решений. Работал в нескольких стартапах, где активно участвовал в выстраивании процессов разработки и доставки продукта до конечных пользователей.</p>","en":"<ul>\n<li></li>\n</ul>\n"},"speaker":false,"committee":false,"photo":{"id":"df52ae21-d629-440f-8146-005f5eacef3b","title":"Федор Сазонов_EDITED.jpg","url":"/squidex/srm/df52ae21-d629-440f-8146-005f5eacef3b/fedor-sazonov-edited.jpg","fileName":"Федор Сазонов_EDITED.jpg","contentType":"image/png","details":{"image":{"width":1731,"height":1557}}},"contacts":[{"type":"github","value":"https://github.com/revenant20"}],"achievements":null,"isPartner":false,"position":{"ru":"Эксперт","en":"Эксперт"},"contributorId":22006346},"currentActivities":[{"id":"7d33248277134c8ebbe50368d028d004","name":{"ru":"OSIV включить нельзя выключить","en":"-"},"talkOrder":50,"shortDescription":{"ru":"<p>Мы расскажем о настройке Spring под названием <code>open-in-view</code>. Она включена по умолчанию, по общепринятому мнению ее надо выключать. А вот точно надо? Может, можно как-то по другому? Или нет?</p>\n<p>Выключить нельзя включить. Приходите, мы расставим запятые вместе!</p>","en":"<p>-</p>"},"longDescription":{"ru":"<p>Мы расскажем о настройке Spring под названием <code>open-in-view</code>. Она включена по умолчанию, по общепринятому мнению ее надо выключать.</p>\n<p>А все-таки, что конкретно делает эта настройка? Почему ее надо выключать именно в начале разработки проекта, а не когда начались проблемы? Что делать, если они начались, а выключить OSIV быстро не получается? И если что-то сделать все-таки можно, то может, и не выключать? Не просто же так <code>open-in-view</code> по умолчание включена?</p>\n<p>Чтобы это понять, нужно поэкспериментировать со спринговым сервисом, почитать исходники Hibernate и вспомнить, как Spring управляет транзакциями.</p>\n<p>Выключить нельзя включить. Приходите, мы расставим запятые вместе!</p>","en":"<p>-</p>"},"isRussianLanguage":true,"speakers":[{"id":"fc59d87325cc4689972614ea55686727","name":{"ru":"Илья Сазонов","en":"- -"},"personRating":50,"company":{"ru":"Spring АйО","en":"-"},"bio":{"ru":"<p>Разработчик. Интересуюсь базами данных и Spring.</p>","en":"<p>-</p>"},"speaker":false,"committee":false,"photo":{"id":"81daad48-5806-4ae5-a982-fec6c2687a23","title":"photo_jug.jpg","url":"/squidex/srm/81daad48-5806-4ae5-a982-fec6c2687a23/photo-jug.jpg","fileName":"photo_jug.jpg","contentType":"image/png","details":{"image":{"width":598,"height":549}}},"contacts":[],"achievements":null,"isPartner":false,"position":{"ru":"Эксперт","en":"Эксперт"},"contributorId":22003712},{"id":"00fc6d2ae1404f0496a573fb0b2daa4e","name":{"ru":"Фёдор Сазонов","en":"- -"},"personRating":50,"company":{"ru":"Spring АйО","en":"-"},"bio":{"ru":"<p>Java-разработчик. За свою карьеру работал как над простым бэкендом для веб-страниц, так и над высоконагруженными серверами для онлайновых многопользовательских мобильных шутеров. Глубоко проникся этой темой и теперь консультирую по созданию игровых решений. Работал в нескольких стартапах, где активно участвовал в выстраивании процессов разработки и доставки продукта до конечных пользователей.</p>","en":"<ul>\n<li></li>\n</ul>\n"},"speaker":false,"committee":false,"photo":{"id":"df52ae21-d629-440f-8146-005f5eacef3b","title":"Федор Сазонов_EDITED.jpg","url":"/squidex/srm/df52ae21-d629-440f-8146-005f5eacef3b/fedor-sazonov-edited.jpg","fileName":"Федор Сазонов_EDITED.jpg","contentType":"image/png","details":{"image":{"width":1731,"height":1557}}},"contacts":[{"type":"github","value":"https://github.com/revenant20"}],"achievements":null,"isPartner":false,"position":{"ru":"Эксперт","en":"Эксперт"},"contributorId":22006346}],"ogImage":{"ru":{"id":"b31efa93-977b-4ff5-9a83-3388a118699e","title":"OSIV включить нельзя выключить_Og_speaker_ru.jpg","url":"/squidex/srm/b31efa93-977b-4ff5-9a83-3388a118699e/osiv-vklyuchits-nelszya-vyklyuchits-og-speaker-ru.jpg","fileName":"OSIV включить нельзя выключить_Og_speaker_ru.jpg","contentType":"image/jpeg","details":{"image":{"width":1920,"height":862}}},"en":{"id":"b31efa93-977b-4ff5-9a83-3388a118699e","title":"OSIV включить нельзя выключить_Og_speaker_ru.jpg","url":"/squidex/srm/b31efa93-977b-4ff5-9a83-3388a118699e/osiv-vklyuchits-nelszya-vyklyuchits-og-speaker-ru.jpg","fileName":"OSIV включить нельзя выключить_Og_speaker_ru.jpg","contentType":"image/jpeg","details":{"image":{"width":1920,"height":862}}}},"talkDay":2,"time":"2025-03-01T09:45:00Z","talkStartTime":"2025-03-01T09:45:00Z","talkEndTime":"2025-03-01T10:45:00Z","trackNumber":1,"tags":[],"videoLinks":[],"complexity":null,"talkId":20006688,"experts":[],"hosts":[],"technicalTags":[],"type":"talk","scope":"regular","topics":[["Основная программа",2]],"isServiceTalk":false,"partners":[]}],"otherActivities":[]},"__N_SSG":true}