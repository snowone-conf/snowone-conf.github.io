6feb-627a-49bb-b837-3529baa829af/snowone-og-ru.jpg","fileName":"SnowOne_og_ru.jpg","contentType":"image/jpeg","details":{"image":{"width":1920,"height":862}}},"en":{"id":"edb26feb-627a-49bb-b837-3529baa829af","title":"SnowOne_og_ru.jpg","url":"/squidex/sites/edb26feb-627a-49bb-b837-3529baa829af/snowone-og-ru.jpg","fileName":"SnowOne_og_ru.jpg","contentType":"image/jpeg","details":{"image":{"width":1920,"height":862}}}},"heroBackground":{"id":"431b7610-d7ac-477d-8a67-81fd85502fbc","title":"hero_background 1.svg","url":"/squidex/sites/431b7610-d7ac-477d-8a67-81fd85502fbc/hero-background-1.svg","fileName":"hero_background 1.svg","contentType":"image/svg+xml","details":{}},"heroLogo":{"id":"e2b0e826-67dd-4a17-b0d7-fe976422679f","title":"hero_art.svg","url":"/squidex/sites/e2b0e826-67dd-4a17-b0d7-fe976422679f/hero-art.svg","fileName":"hero_art.svg","contentType":"image/svg+xml","details":{}},"headerLogo":{"id":"87845d2b-cc0c-4f67-b63a-1329e02206c1","title":"snowone_header_logo.svg","url":"/squidex/sites/87845d2b-cc0c-4f67-b63a-1329e02206c1/snowone-header-logo.svg","fileName":"snowone_header_logo.svg","contentType":"image/svg+xml","details":{}},"footerLogo":{"id":"0ea6f580-0fe3-4345-92a0-a4806f38a158","title":"snowone_footer_logo.svg","url":"/squidex/sites/0ea6f580-0fe3-4345-92a0-a4806f38a158/snowone-footer-logo.svg","fileName":"snowone_footer_logo.svg","contentType":"image/svg+xml","details":{}},"subscriptionBannerImage":{"id":"9457e34d-03de-4135-a661-a6e2761f322d","title":"snowone-subscription-bg 1.svg","url":"/squidex/sites/9457e34d-03de-4135-a661-a6e2761f322d/snowone-subscription-bg-1.svg","fileName":"snowone-subscription-bg 1.svg","contentType":"image/svg+xml","details":{}},"partnersBannerImage":{"id":"2ca761e0-62ca-4203-a6bd-a99329b0ac87","title":"partner-snowone.svg","url":"/squidex/sites/2ca761e0-62ca-4203-a6bd-a99329b0ac87/partner-snowone.svg","fileName":"partner-snowone.svg","contentType":"image/svg+xml","details":{}}},"states":{"sectionStates":7741052,"clientStates":1298,"scheduleGrouping":["days"],"scheduleSettings":["sorting"]},"currentConferenceName":{"ru":"SnowOne","en":"SnowOne"},"timestamps":{"static":1790341392482,"data":1790341322320},"status":"current"}}},"projects":[],"meta":{"title":"Роман Елизаров на SnowOne 2025","description":"Эксперт по многопоточности и распределенному программированию, преподаю тематический курс в ИТМО в Санкт-Петербурге.\n15 лет разрабатывал высоконагруженные системы для бирж и брокеров в Devexperts, преимущественно используя Java. В недавнем прошлом 7 лет работал в JetBrains, где возглавлял команду, работающую над языком Kotlin, фокусируясь на дизайне языка и библиотек. Автор корутин в Kotlin &mdash; механизма для асинхронных вычислений.\nСейчас руковожу отделом улучшения опыта разработки в бизнес-группе Екома и Райдтеха Яндекса, где отвечаю за удобство работы и счастье разработчиков."},"localeConfig":{"locales":["ru"],"defaultLocale":"ru"},"locale":"ru","person":{"id":"bc354f2a7d8c44dfa16f9c1644631a42","name":{"ru":"Роман Елизаров","en":"- -"},"personRating":100,"company":{"ru":"Яндекс","en":"-"},"bio":{"ru":"<p>Эксперт по многопоточности и распределенному программированию, преподаю тематический курс в ИТМО в Санкт-Петербурге.</p>\n<p>15 лет разрабатывал высоконагруженные системы для бирж и брокеров в Devexperts, преимущественно используя Java. В недавнем прошлом 7 лет работал в JetBrains, где возглавлял команду, работающую над языком Kotlin, фокусируясь на дизайне языка и библиотек. Автор корутин в Kotlin &mdash; механизма для асинхронных вычислений.</p>\n<p>Сейчас руковожу отделом улучшения опыта разработки в бизнес-группе Екома и Райдтеха Яндекса, где отвечаю за удобство работы и счастье разработчиков.</p>","en":"<p>-</p>"},"speaker":false,"committee":false,"photo":{"id":"8929fb89-372a-4ad5-8746-ebf90a2d28c8","title":"Roman.Elizarov.jpg","url":"/squidex/srm/8929fb89-372a-4ad5-8746-ebf90a2d28c8/roman.elizarov.jpg","fileName":"Roman.Elizarov.jpg","contentType":"image/jpeg","details":{"image":{"width":644,"height":644}}},"contacts":[],"achievements":null,"isPartner":false,"contributorId":22000140},"currentActivities":[{"id":"44e68706fdac4cc5885e2a5fe98a6bd2","name":{"ru":"Уроки Kotlin, или Зачем создавать еще один язык программирования","en":"-"},"talkOrder":50,"shortDescription":{"ru":"<p>В мире есть множество языков программирования. Казалось бы, для каждой задачи уже какой-то язык есть &mdash; просто бери и используй. Так зачем же делать еще один? Зачем мы создавали язык Kotlin? Чего нам не хватало в Java? Является ли Kotlin теперь идеальным языком? Чего не хватает в Kotlin?&nbsp;</p>","en":"<p>-</p>"},"longDescription":{"ru":"<p>В мире есть множество языков программирования. Казалось бы, для каждой задачи уже какой-то язык есть &mdash; просто бери и используй. Так зачем же делать еще один? Зачем мы создавали язык Kotlin? Чего нам не хватало в Java? Является ли Kotlin теперь идеальным языком? Чего не хватает в Kotlin?</p>\n<p>Приходите, если вам интересны ответы на эти вопросы или вы просто интересуетесь языками программирования. Я расскажу об основных аспектах старых и современных языков, на которые стоит обращать внимание, и объясню, почему дизайн языка программирования &mdash; это всегда компромиcс.</p>","en":"<p>-</p>"},"isRussianLanguage":true,"speakers":[{"id":"bc354f2a7d8c44dfa16f9c1644631a42","name":{"ru":"Роман Елизаров","en":"- -"},"personRating":100,"company":{"ru":"Яндекс","en":"-"},"bio":{"ru":"<p>Эксперт по многопоточности и распределенному программированию, преподаю тематический курс в ИТМО в Санкт-Петербурге.</p>\n<p>15 лет разрабатывал высоконагруженные системы для бирж и брокеров в Devexperts, преимущественно используя Java. В недавнем прошлом 7 лет работал в JetBrains, где возглавлял команду, работающую над языком Kotlin, фокусируясь на дизайне языка и библиотек. Автор корутин в Kotlin &mdash; механизма для асинхронных вычислений.</p>\n<p>Сейчас руковожу отделом улучшения опыта разработки в бизнес-группе Екома и Райдтеха Яндекса, где отвечаю за удобство работы и счастье разработчиков.</p>","en":"<p>-</p>"},"speaker":false,"committee":false,"photo":{"id":"8929fb89-372a-4ad5-8746-ebf90a2d28c8","title":"Roman.Elizarov.jpg","url":"/squidex/srm/8929fb89-372a-4ad5-8746-ebf90a2d28c8/roman.elizarov.jpg","fileName":"Roman.Elizarov.jpg","contentType":"image/jpeg","details":{"image":{"width":644,"height":644}}},"contacts":[],"achievements":null,"isPartner":false,"contributorId":22000140}],"ogImage":{"ru":{"id":"2baee343-4525-4ab3-844f-d42e101607da","title":"Уроки Kotlin, или Зачем создавать еще один язык пр_Og_speaker_ru.jpg","url":"/squidex/srm/2baee343-4525-4ab3-844f-d42e101607da/uroki-kotlin-ili-zachem-sozdavats-eshe-odin-yazyk-pr-og-speaker-ru.jpg","fileName":"Уроки Kotlin, или Зачем создавать еще один язык пр_Og_speaker_ru.jpg","contentType":"image/jpeg","details":{"image":{"width":1920,"height":862}}},"en":{"id":"2baee343-4525-4ab3-844f-d42e101607da","title":"Уроки Kotlin, или Зачем создавать еще один язык пр_Og_speaker_ru.jpg","url":"/squidex/srm/2baee343-4525-4ab3-844f-d42e101607da/uroki-kotlin-ili-zachem-sozdavats-eshe-odin-yazyk-pr-og-speaker-ru.jpg","fileName":"Уроки Kotlin, или Зачем создавать еще один язык пр_Og_speaker_ru.jpg","contentType":"image/jpeg","details":{"image":{"width":1920,"height":862}}}},"talkDay":1,"time":"2025-02-28T12:30:00Z","talkStartTime":"2025-02-28T12:30:00Z","talkEndTime":"2025-02-28T13:15:00Z","trackNumber":1,"tags":[],"videoLinks":[],"complexity":null,"talkId":20006900,"experts":[],"hosts":[],"technicalTags":[],"type":"talk","scope":"regular","topics":[["Студенческий день",1]],"isServiceTalk":false,"partners":[]}],"otherActivities":[]},"__N_SSG":true}