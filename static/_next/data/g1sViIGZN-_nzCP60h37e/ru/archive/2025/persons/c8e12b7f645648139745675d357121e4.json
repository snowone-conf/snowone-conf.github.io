ates":1298,"scheduleGrouping":["days"],"scheduleSettings":["sorting"]},"currentConferenceName":{"ru":"SnowOne","en":"SnowOne"},"timestamps":{"static":1790341433818,"data":1790341322320},"status":"current"}}},"projects":[],"meta":{"title":"Александр Никитин на SnowOne 2025","description":"Работаю с базами данных. Когда-то специализировался на Oracle, но уже довольно давно перешел на работу с PostgreSQL. Состою в Программном комитете конференции PG BootCamp.\nЗанимаюсь гиревым спортом.\n&nbsp;"},"localeConfig":{"locales":["ru"],"defaultLocale":"ru"},"locale":"ru","person":{"id":"c8e12b7f645648139745675d357121e4","name":{"ru":"Александр Никитин","en":"- -"},"personRating":100,"company":{"ru":"DBA Team","en":"-"},"bio":{"ru":"<p>Работаю с базами данных. Когда-то специализировался на Oracle, но уже довольно давно перешел на работу с PostgreSQL. Состою в Программном комитете конференции PG BootCamp.</p>\n<p>Занимаюсь гиревым спортом.</p>\n<p>&nbsp;</p>","en":"<p>-</p>"},"speaker":false,"committee":false,"photo":{"id":"d68672ed-c3d3-43ee-a9f6-043794b1206b","title":"BUCTl-eFkqw.jpg","url":"/squidex/srm/d68672ed-c3d3-43ee-a9f6-043794b1206b/buctl-efkqw.jpg","fileName":"BUCTl-eFkqw.jpg","contentType":"image/png","details":{"image":{"width":494,"height":446}}},"contacts":[],"achievements":null,"isPartner":false,"position":{"ru":"ДБА / Генеральный директор","en":"ДБА / Генеральный директор"},"contributorId":22007397},"currentActivities":[{"id":"360ba30bd90948ce9daea1adf5768bce","name":{"ru":"Работа с запросами с точки зрения DBA","en":"-"},"talkOrder":100,"shortDescription":{"ru":"<p>Есть мнение, что ускорить работу запросов можно только при помощи создания соответствующих индексов. Конечно, часть вопросов, связанных с производительностью, индексы действительно снимают, но это всего лишь часть. В докладе рассмотрим инструменты и различные подходы, которые вы можете использовать для ускорения работы ваших запросов.</p>","en":"<p>-</p>"},"longDescription":{"ru":"<p>Поговорим об инструментах, которые мы используем в своей работе. Рассмотрим несколько интересных кейсов работы с запросами. Обсудим влияние индексов и статистики на производительность.</p>","en":"<p>-</p>"},"isRussianLanguage":true,"speakers":[{"id":"c8e12b7f645648139745675d357121e4","name":{"ru":"Александр Никитин","en":"- -"},"personRating":100,"company":{"ru":"DBA Team","en":"-"},"bio":{"ru":"<p>Работаю с базами данных. Когда-то специализировался на Oracle, но уже довольно давно перешел на работу с PostgreSQL. Состою в Программном комитете конференции PG BootCamp.</p>\n<p>Занимаюсь гиревым спортом.</p>\n<p>&nbsp;</p>","en":"<p>-</p>"},"speaker":false,"committee":false,"photo":{"id":"d68672ed-c3d3-43ee-a9f6-043794b1206b","title":"BUCTl-eFkqw.jpg","url":"/squidex/srm/d68672ed-c3d3-43ee-a9f6-043794b1206b/buctl-efkqw.jpg","fileName":"BUCTl-eFkqw.jpg","contentType":"image/png","details":{"image":{"width":494,"height":446}}},"contacts":[],"achievements":null,"isPartner":false,"position":{"ru":"ДБА / Генеральный директор","en":"ДБА / Генеральный директор"},"contributorId":22007397}],"ogImage":{"ru":{"id":"7c60b603-6ea7-4be4-ab4a-46a7e76d1eab","title":"Работа с запросами с точки зрения DBA_Og_speaker_ru.jpg","url":"/squidex/srm/7c60b603-6ea7-4be4-ab4a-46a7e76d1eab/rabota-s-zaprosami-s-tochki-zreniya-dba-og-speaker-ru.jpg","fileName":"Работа с запросами с точки зрения DBA_Og_speaker_ru.jpg","contentType":"image/jpeg","details":{"image":{"width":1920,"height":862}}},"en":{"id":"7c60b603-6ea7-4be4-ab4a-46a7e76d1eab","title":"Работа с запросами с точки зрения DBA_Og_speaker_ru.jpg","url":"/squidex/srm/7c60b603-6ea7-4be4-ab4a-46a7e76d1eab/rabota-s-zaprosami-s-tochki-zreniya-dba-og-speaker-ru.jpg","fileName":"Работа с запросами с точки зрения DBA_Og_speaker_ru.jpg","contentType":"image/jpeg","details":{"image":{"width":1920,"height":862}}}},"talkDay":2,"time":"2025-03-01T09:45:00Z","talkStartTime":"2025-03-01T09:45:00Z","talkEndTime":"2025-03-01T10:45:00Z","trackNumber":3,"tags":[],"videoLin