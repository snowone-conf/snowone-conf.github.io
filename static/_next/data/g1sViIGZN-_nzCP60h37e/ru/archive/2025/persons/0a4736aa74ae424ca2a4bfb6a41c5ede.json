ates":1298,"scheduleGrouping":["days"],"scheduleSettings":["sorting"]},"currentConferenceName":{"ru":"SnowOne","en":"SnowOne"},"timestamps":{"static":1790274843265,"data":1790274763461},"status":"current"}}},"projects":[],"meta":{"title":"Григорий Кошелев на SnowOne 2025","description":"Более 10 лет разрабатываю информационные системы различной сложности и масштаба. Выступил с более чем 30 докладами на конференциях и митапах для разработчиков. Среди тем докладов &mdash; Apache Kafka, Elasticsearch, Sentry, распределенные и event-driven системы."},"localeConfig":{"locales":["ru"],"defaultLocale":"ru"},"locale":"ru","person":{"id":"0a4736aa74ae424ca2a4bfb6a41c5ede","name":{"ru":"Григорий Кошелев","en":"Gregory Koshelev "},"personRating":130,"bio":{"ru":"<p>Более 10 лет разрабатываю информационные системы различной сложности и масштаба. Выступил с более чем 30 докладами на конференциях и митапах для разработчиков. Среди тем докладов &mdash; Apache Kafka, Elasticsearch, Sentry, распределенные и event-driven системы.</p>","en":"<p>Grigory has been developing information systems of various complexity and scale for more than 10 years. He has given more than 30 talks at conferences and developer meetups. The topics of his talks include Apache Kafka, Elasticsearch, Sentry, distributed and event-driven systems.</p>"},"speaker":false,"committee":false,"photo":{"id":"44d41fb4-c2b2-4307-89dc-b0a52a3ea8df","title":"koshelev-2022.jpg","url":"/squidex/srm/44d41fb4-c2b2-4307-89dc-b0a52a3ea8df/koshelev-2022.jpg","fileName":"koshelev-2022.jpg","contentType":"image/png","details":{"image":{"width":802,"height":707}}},"contacts":[],"achievements":null,"isPartner":false,"contributorId":22003021},"currentActivities":[],"otherActivities":[]},"__N_SSG":true}