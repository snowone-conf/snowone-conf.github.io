ates":1298,"scheduleGrouping":["days"],"scheduleSettings":["sorting"]},"currentConferenceName":{"ru":"SnowOne","en":"SnowOne"},"timestamps":{"static":1790279845432,"data":1790279644670},"status":"current"}}},"projects":[],"meta":{"title":"Роман Артемьев на SnowOne 2025","description":"VM/Compiler engineer. Люблю системное программирование, ОС, компиляторы и всякую черную магию вокруг. Занимаюсь Android Runtime."},"localeConfig":{"locales":["ru"],"defaultLocale":"ru"},"locale":"ru","person":{"id":"d059151d9f1044ec92045be06a20871f","name":{"ru":"Роман Артемьев","en":"Роман Артемьев"},"personRating":100,"company":{"ru":"Syntacore","en":"Syntacore"},"bio":{"ru":"<p>VM/Compiler engineer. Люблю системное программирование, ОС, компиляторы и всякую черную магию вокруг. Занимаюсь Android Runtime.</p>","en":"<p>VM/Compiler engineer. Люблю системное программирование, ОС, компиляторы и всякую черную магию вокруг. Занимаюсь Android Runtime.</p>"},"speaker":false,"committee":false,"photo":{"id":"52e7696f-40e2-4ff3-b562-1abdacde5ac1","title":"photo_2025-01-17 10.07.57.jpeg","url":"/squidex/srm/52e7696f-40e2-4ff3-b562-1abdacde5ac1/photo-2025-01-17-10.07.57.jpeg","fileName":"photo_2025-01-17 10.07.57.jpeg","contentType":"image/png","details":{"image":{"width":612,"height":595}}},"contacts":[],"achievements":null,"isPartner":false,"contributorId":22000370},"currentActivities":[{"id":"65aedebf5a514783a7c7f0d3e8e01c5d","name":{"ru":"ART Memory Management","en":"-"},"talkOrder":100,"shortDescription":{"ru":"<p>ART &mdash; Android RunTime &mdash; виртуальная машина в ОС Android, в которой исполняются пользовательские приложения. ART можно считать альтернативной реализацией VM для языка Java, в котором есть свои интересные особенности, в частности механизм управления памятью и сборкой мусора. К сожалению, эту тему все еще слабо освещают. Предлагаю исправить это недоразумение и погрузиться в Java-мир, альтернативный мейнстримному OpenJDK, и узнать, как бывает еще.</p>","en":"<p>-</p>"},"longDescription":{"ru":"<p>ART &mdash; Android RunTime &mdash; виртуальная машина в ОС Android, в которой исполняются пользовательские приложения. ART можно считать альтернативной реализацией VM для языка Java, в котором есть свои интересные особенности, в частности механизм управления памятью и сборкой мусора. К сожалению, эту тему все еще слабо освещают. Предлагаю исправить это недоразумение и погрузиться в Java-мир, альтернативный мейнстримному OpenJDK, и узнать, как бывает еще.</p>","en":"<p>-</p>"},"isRussianLanguage":true,"speakers":[{"id":"d059151d9f1044ec92045be06a20871f","name":{"ru":"Роман Артемьев","en":"Роман Артемьев"},"personRating":100,"company":{"ru":"Syntacore","en":"Syntacore"},"bio":{"ru":"<p>VM/Compiler engineer. Люблю системное программирование, ОС, компиляторы и всякую черную магию вокруг. Занимаюсь Android Runtime.</p>","en":"<p>VM/Compiler engineer. Люблю системное программирование, ОС, компиляторы и всякую черную магию вокруг. Занимаюсь Android Runtime.</p>"},"speaker":false,"committee":false,"photo":{"id":"52e7696f-40e2-4ff3-b562-1abdacde5ac1","title":"photo_2025-01-17 10.07.57.jpeg","url":"/squidex/srm/52e7696f-40e2-4ff3-b562-1abdacde5ac1/photo-2025-01-17-10.07.57.jpeg","fileName":"photo_2025-01-17 10.07.57.jpeg","contentType":"image/png","details":{"image":{"width":612,"height":595}}},"contacts":[],"achievements":null,"isPartner":false,"contributorId":22000370}],"ogImage":{"ru":{"id":"20c41417-5066-4c98-a8e9-c61690d12f73","title":"ART Memory Management_Og_speaker_ru.jpg","url":"/squidex/srm/20c41417-5066-4c98-a8e9-c61690d12f73/art-memory-management-og-speaker-ru.jpg","fileName":"ART Memory Management_Og_speaker_ru.jpg","contentType":"image/jpeg","details":{"image":{"width":1920,"height":862}}},"en":{"id":"20c41417-5066-4c98-a8e9-c61690d12f73","title":"ART Memory Management_Og_speaker_ru.jpg","url":"/squidex/srm/20c41417-5066-4c98-a8e9-c61690d12f73/art-memory-management-og-speaker-ru.jpg","fileName":"ART Memory Management_Og_speaker_ru.jpg",