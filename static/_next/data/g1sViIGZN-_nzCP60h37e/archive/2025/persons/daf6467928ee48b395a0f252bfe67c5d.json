ates":1298,"scheduleGrouping":["days"],"scheduleSettings":["sorting"]},"currentConferenceName":{"ru":"SnowOne","en":"SnowOne"},"timestamps":{"static":1790341386613,"data":1790341322320},"status":"current"}}},"projects":[],"meta":{"title":"Илья Гаврилин на SnowOne 2025","description":"В Syntacore занимаюсь оптимизацией managed языков. Оптимизировал математические функции в OpenJDK. Соавтор порта компилятора Maglev на RISC-V."},"localeConfig":{"locales":["ru"],"defaultLocale":"ru"},"locale":"ru","person":{"id":"daf6467928ee48b395a0f252bfe67c5d","name":{"ru":"Илья Гаврилин","en":"- -"},"personRating":100,"company":{"ru":"Syntacore","en":"-"},"bio":{"ru":"<p>В Syntacore занимаюсь оптимизацией managed языков. Оптимизировал математические функции в OpenJDK. Соавтор порта компилятора Maglev на RISC-V.</p>","en":"<p>-</p>"},"speaker":false,"committee":false,"photo":{"id":"ed257f74-5654-4764-b196-79a72b892faa","title":"ava.jpg","url":"/squidex/srm/ed257f74-5654-4764-b196-79a72b892faa/ava.jpg","fileName":"ava.jpg","contentType":"image/png","details":{"image":{"width":433,"height":389}}},"contacts":[],"achievements":null,"isPartner":false,"contributorId":22001136},"currentActivities":[{"id":"794ec118e4d2427388377a96ee967374","name":{"ru":"Развивая процессор: делаем JVM еще быстрее","en":"-"},"talkOrder":100,"shortDescription":{"ru":"<p>Обсудим, как устроен современный процессор, какие секреты он таит. Узнаем, зачем Java-разработчику знать, как работает процессор и как мы можем влиять на его работу.</p>","en":"<p>-</p>"},"longDescription":{"ru":"<p>Современный микропроцессор &mdash; это не просто совокупность транзисторов, а уже настоящий &laquo;живой организм&raquo; со своими тайнами и парадоксами. В его конвейерной системе каждый такт имеет значение, а решения о будущем принимаются в доли наносекунд. Процессор пытается предсказывать будущее, изменяет сгенерированные инструкции, стараясь минимизировать простои и максимизировать производительность, хотя порой и ошибается.</p>\n<p>Обсудим, как все эти &laquo;фокусы&raquo; улучшают производительность Java. Вы узнаете, как из кода можете влиять на поведение процессора, чего стоит избегать. И, наконец, вы убедитесь, что микроархитектура может влиять на исполнение кода. Мы также рассмотрим примеры, где подобные оптимизации дают реальный прирост, а где могут стать источником неожиданных проблем.</p>","en":"<p>-</p>"},"isRussianLanguage":true,"speakers":[{"id":"daf6467928ee48b395a0f252bfe67c5d","name":{"ru":"Илья Гаврилин","en":"- -"},"personRating":100,"company":{"ru":"Syntacore","en":"-"},"bio":{"ru":"<p>В Syntacore занимаюсь оптимизацией managed языков. Оптимизировал математические функции в OpenJDK. Соавтор порта компилятора Maglev на RISC-V.</p>","en":"<p>-</p>"},"speaker":false,"committee":false,"photo":{"id":"ed257f74-5654-4764-b196-79a72b892faa","title":"ava.jpg","url":"/squidex/srm/ed257f74-5654-4764-b196-79a72b892faa/ava.jpg","fileName":"ava.jpg","contentType":"image/png","details":{"image":{"width":433,"height":389}}},"contacts":[],"achievements":null,"isPartner":false,"contributorId":22001136}],"ogImage":{"ru":{"id":"29cb893b-0406-4ab6-846f-7c8838af6aa0","title":"Развивая процессор делаем JVM еще быстрее_Og_speaker_ru.jpg","url":"/squidex/srm/29cb893b-0406-4ab6-846f-7c8838af6aa0/razvivaya-processor-delaem-jvm-eshe-bystree-og-speaker-ru.jpg","fileName":"Развивая процессор делаем JVM еще быстрее_Og_speaker_ru.jpg","contentType":"image/jpeg","details":{"image":{"width":1920,"height":862}}},"en":{"id":"29cb893b-0406-4ab6-846f-7c8838af6aa0","title":"Развивая процессор делаем JVM еще быстрее_Og_speaker_ru.jpg","url":"/squidex/srm/29cb893b-0406-4ab6-846f-7c8838af6aa0/razvivaya-processor-delaem-jvm-eshe-bystree-og-speaker-ru.jpg","fileName":"Развивая процессор делаем JVM еще быстрее_Og_speaker_ru.jpg","contentType":"image/jpeg","details":{"image":{"width":1920,"height":862}}}},"talkDay":2,"time":"2025-03-01T04:45:00Z","talkStartTime":"2025-03-01T04:45:00Z","talkEndTime":"2025-03-01T05:45:00Z