ates":1298,"scheduleGrouping":["days"],"scheduleSettings":["sorting"]},"currentConferenceName":{"ru":"SnowOne","en":"SnowOne"},"timestamps":{"static":1790341440956,"data":1790341322320},"status":"current"}}},"projects":[],"meta":{"title":"Екатерина Шевчук на SnowOne 2025","description":"Старший инженер-разработчик. Тимлид инфраструктурной команды. Куратор курсов ШИФТ Интенсив в Koronatech, направление &laquo;Java-разработка&raquo;. Участник Программного комитета направления Backend в Koronatech (для внутренних и внешних конференций). Выступала на внешних митапах от своей компании и на SnowOne в 2024 году."},"localeConfig":{"locales":["ru"],"defaultLocale":"ru"},"locale":"ru","person":{"id":"ea0bb75595794d4580a6301dc400dcc0","name":{"ru":"Екатерина Шевчук","en":"Екатерина Шевчук"},"personRating":50,"company":{"ru":"Koronatech","en":"ЦФТ"},"bio":{"ru":"<p>Старший инженер-разработчик. Тимлид инфраструктурной команды. Куратор курсов ШИФТ Интенсив в Koronatech, направление &laquo;Java-разработка&raquo;. Участник Программного комитета направления Backend в Koronatech (для внутренних и внешних конференций). Выступала на внешних митапах от своей компании и на SnowOne в 2024 году.</p>","en":"<p>Старший инженер-разработчик. Тимлид инфраструктурной команды. Куратор курсов ШИФТ Интенсив в Koronatech, направление &laquo;Java-разработка&raquo;. Участник Программного комитета направления Backend в Koronatech (для внутренних и внешних конференций). Выступала на внешних митапах от своей компании и на SnowOne в 2024 году.</p>"},"speaker":false,"committee":false,"photo":{"id":"d25e65b6-c12f-4487-99ce-b23d8f8bd0ea","title":"шевчук.jpg","url":"/squidex/srm/d25e65b6-c12f-4487-99ce-b23d8f8bd0ea/shevchuk.jpg","fileName":"шевчук.jpg","contentType":"image/png","details":{"image":{"width":2436,"height":2192}}},"contacts":[],"achievements":null,"isPartner":false,"position":{"ru":"Старший инженер-программист","en":"Старший инженер-программист"},"contributorId":22005413},"currentActivities":[{"id":"5cba1c5ed10842d09bbfa23af304f387","name":{"ru":"Разберемся с СI/CD: что это такое и зачем нужно разработчику","en":"-"},"talkOrder":50,"shortDescription":{"ru":"<p>Разберемся, что такое CI/CD, для чего нужно и зачем об этом знать разработчику. Рассмотрим основные этапы и пример реализации.</p>","en":"<p>-</p>"},"longDescription":{"ru":"<p>Скорость поставки и качество продукта &mdash; главные конкурентные преимущества в разработке ПО. Поэтому важно использовать лучшие практики сообщества для обеспечения этих двух пунктов. Одной из таких практик является CI/CD &mdash; Continuous Integration и Continuous Delivery &mdash; непрерывная интеграция и непрерывная доставка. Она помогает свести ошибки к минимуму, повысить качество разрабатываемого продукта и увеличить скорость его поставки клиенту. Без непрерывной интеграции сотрудничество разработчиков превращается в утомительный ручной процесс координации обновлений и слияний кода.</p>\n<p>Но, как и любой процесс, он может дорабатываться, ломаться и так далее. Поэтому, чтобы обеспечить бесперебойное время и качество поставки, важно понимать, из чего он состоит, какие подводные камни могут быть на каждом из этапов.</p>\n<p>В докладе как раз разберем на примере, чем это полезно не только с точки зрения конкурентных преимуществ для бизнеса, но и для самих разработчиков. Посмотрим, в чем преимущества и недостатки этой методологии. И разберем пример реализации с помощью инструмента Jenkins.</p>","en":"<p>-</p>"},"isRussianLanguage":true,"speakers":[{"id":"ea0bb75595794d4580a6301dc400dcc0","name":{"ru":"Екатерина Шевчук","en":"Екатерина Шевчук"},"personRating":50,"company":{"ru":"Koronatech","en":"ЦФТ"},"bio":{"ru":"<p>Старший инженер-разработчик. Тимлид инфраструктурной команды. Куратор курсов ШИФТ Интенсив в Koronatech, направление &laquo;Java-разработка&raquo;. Участник Программного комитета направления Backend в Koronatech (для внутренних и внешних конференций). Выступала на внешних митапах от своей компании и на SnowOne в 2024 году.</p>","en":"<p>Старший инженер-разработчик. Тимлид инфраструктурной команды. Куратор курсов ШИФТ Интенсив в Koronatech, направление &laquo;Java-разработка&raquo;. Участник Программного комитета направления Backend в Koronatech (для внутренних и внешних конференций). Выступала на внешних митапах от своей компании и на SnowOne в 2024 году.</p>"},"speaker":false,"committee":false,"photo":{"id":"d25e65b6-c12f-4487-99ce-b23d8f8bd0ea","title":"шевчук.jpg","url":"/squidex/srm/d25e65b6-c12f-4487-99ce-b23d8f8bd0ea/shevchuk.jpg","fileName":"шевчук.jpg","contentType":"image/png","details":{"image":{"width":2436,"height":2192}}},"contacts":[],"achievements":null,"isPartner":false,"position":{"ru":"Старший инженер-программист","en":"Старший инженер-программист"},"contributorId":22005413}],"ogImage":{"ru":{"id":"772aa524-59bc-4d0f-aaea-1dcf4d6de5d3","title":"CD_ что это такое и зачем нужно ра_Og_speaker_ru.jpg","url":"/squidex/srm/772aa524-59bc-4d0f-aaea-1dcf4d6de5d3/cd-chto-eto-takoe-i-zachem-nuzhno-ra-og-speaker-ru.jpg","fileName":"CD_ что это такое и зачем нужно ра_Og_speaker_ru.jpg","contentType":"image/jpeg","details":{"image":{"width":1920,"height":862}}},"en":{"id":"772aa524-59bc-4d0f-aaea-1dcf4d6de5d3","title":"CD_ что это такое и зачем нужно ра_Og_speaker_ru.jpg","url":"/squidex/srm/772aa524-59bc-4d0f-aaea-1dcf4d6de5d3/cd-chto-eto-takoe-i-zachem-nuzhno-ra-og-speaker-ru.jpg","fileName":"CD_ что это такое и зачем нужно ра_Og_speaker_ru.jpg","contentType":"image/jpeg","details":{"image":{"width":1920,"height":862}}}},"talkDay":1,"time":"2025-02-28T11:30:00Z","talkStartTime":"2025-02-28T11:30:00Z","talkEndTime":"2025-02-28T12:15:00Z","trackNumber":1,"tags":[],"videoLinks":[],"complexity":null,"talkId":20006687,"experts":[],"hosts":[],"technicalTags":[],"type":"talk","scope":"regular","topics":[["Студенческий день",1]],"isServiceTalk":false,"partners":[]}],"otherActivities":[]},"__N_SSG":true}